    "@octanejs/tanstack-table": "^0.1.46",
    "@typegpu/noise": "^0.12.0",
    "@typegpu/three": "^0.12.0",
    "beast-tsrx": "^0.2.9",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "octane": "^0.1.49",
    "typegpu": "^0.12.0"
  },
  "devDependencies": {
    "@octanejs/rspack-plugin": "0.1.44",
    "@rspack/cli": "^2",
    "@rspack/core": "^2",
    "@rspack/dev-server": "^2",
    "@tailwindcss/postcss": "^4",
    "@tsrx/typescript-plugin": "0.3.128",
    "@types/node": "^26.4.0",
    "@types/three": "^0.185.4",
    "@webgpu/types": "^0.1.72",
