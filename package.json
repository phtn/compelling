{
  "name": "compelling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack dev --config rspack.config.mjs",
    "build": "rspack build --mode production --config rspack.config.mjs",
    "preview": "rspack serve --config rspack.config.mjs --mode production",
    "format": "prettier --write .",
