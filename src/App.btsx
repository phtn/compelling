import Home from "./pages/home.btsx"
import CanvasDemo from "./demos/canvas.btsx"
import FormDemo from "./demos/form.btsx"
import GridDemo from "./demos/grid.btsx"
import ShellDemo from "./demos/shell.btsx"
import TimelineDemo from "./demos/timeline.btsx"
import WorkerDemo from "./demos/worker.btsx"
import MotionDemo from "./demos/motion.btsx"
import StreamingDemo from "./demos/streaming.btsx"
import Brand from "./components/ui/brand.btsx"
import Button from "./components/ui/button.btsx"
import Tag from "./components/ui/tag.btsx"
import SidebarItem from "./components/ui/sidebar/sidebar-item.btsx"
import { navGroups } from "./components/ui/sidebar/navs"
import Icon from "./lib/icons/index.btsx"
import { cn } from "./lib/utils"
import { useEffect, useState } from "octane"

setup
  const [path, setPath] = useState(typeof window !== "undefined" ? window.location.pathname : "/")
  const [sidebarOpen, setSidebarOpen] = useState(true)
  const [sidebarSide, setSidebarSide] = useState<"left" | "right">("left")
  const [theme, setTheme] = useState<"dark" | "light">("dark")
  const navigate = (to: string) => (e: MouseEvent) => {
    e.preventDefault()
    if (to !== window.location.pathname) {
      window.history.pushState(null, "", to)
      setPath(to)
      window.scrollTo(0, 0)
    }
  }
  useEffect(() => {
    const onPop = () => setPath(window.location.pathname)
    window.addEventListener("popstate", onPop)
    const onClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement
      const anchor = target.closest("a")
      if (anchor instanceof HTMLAnchorElement && anchor.href.startsWith(window.location.origin) && anchor.target !== "_blank" && anchor.hasAttribute("href")) {
        const url = new URL(anchor.href)
        if (url.pathname !== window.location.pathname) {
          e.preventDefault()
          window.history.pushState(null, "", url.pathname + url.search + url.hash)
          setPath(url.pathname)
          window.scrollTo(0, 0)
        }
      }
    }
    document.addEventListener("click", onClick)
    return () => {
      window.removeEventListener("popstate", onPop)
      document.removeEventListener("click", onClick)
    }
  }, [])
  useEffect(() => {
    const mq = window.matchMedia("(max-width: 768px)")
    const apply = () => setSidebarOpen(!mq.matches)
    apply()
    const handler = () => apply()
    mq.addEventListener("change", handler)
    return () => mq.removeEventListener("change", handler)
  }, [])
  useEffect(() => {
    const saved = localStorage.getItem("theme") as "dark" | "light" | null
    const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches
    const initial = saved ?? (prefersLight ? "light" : "dark")
    setTheme(initial)
    document.documentElement.setAttribute("data-theme", initial)
  }, [])
  useEffect(() => {
    document.documentElement.setAttribute("data-theme", theme)
    localStorage.setItem("theme", theme)
  }, [theme])
  const toggleTheme = () => setTheme(theme === "dark" ? "light" : "dark")

  const navs = navGroups[0].items

div(className="min-h-screen text-[#ededed] selection:bg-white selection:text-black antialiased")
  header(className="sticky top-0 z-40 backdrop-blur-3xl border-b border-[#1a1a1a] w-full")
    div(className="w-full px-4 flex items-center justify-between h-[64px] gap-4")
      Brand(imageUrl="https://res.cloudinary.com/dx0heqhhe/image/upload/v1786873658/compel-up_tao32q.svg")
      nav(className="hidden md:flex items-center gap-0 text-[13px] font-medium")
        each nav in navs key nav.href
          Tag(href={nav.href} target="_self" variant={path === nav.href ? "secondary" : "ghost"} label={nav.label} onClick={navigate(nav.href)})
      div(className="flex items-center gap-2")
        Button(size='icon' icon='theme' variant='secondary' onClick={toggleTheme} aria-label="Toggle theme")
        Tag(label="Beast Docs" variant="secondary" href="https://beast-docs.vercel.app")

  div(className="flex w-full min-h-[calc(100vh-64px)]")
    if sidebarSide === "left" && sidebarOpen
      aside(className="hidden md:flex w-[256px] shrink-0 border-r border-[#1a1a1a] flex-col sticky top-[64px] h-[calc(100vh-64px)] overflow-hidden")
        div(className="flex items-center justify-between h-[44px] px-3 shrink-0")
          div(className="text-2xs font-mono opacity-50 tracking-widest") NAVIGATION
          div(className="flex items-center")
            button(className="size-6 aspect-square rounded-none rounded-s-xs border border-r-0 border-[#1a1a1a] grid place-items-center text-[11px] text-[#666] hover:text-white hover:border-[#262626] transition" onClick={() => setSidebarSide("right")} aria-label="Move to right")
              Icon(name="arrow-right" className="" size={16})
            button(className="size-6 aspect-square rounded-none rounded-e-xs border border-[#1a1a1a] grid place-items-center text-[11px] text-[#666] hover:text-white hover:border-[#262626] transition" onClick={() => setSidebarOpen(false)} aria-label="Close sidebar")
              Icon(name="close-small" className="" size={16})


        div(className="flex-1 overflow-y-auto p-3 space-y-6")
          each group in navGroups key group.title
            div
              div(className="text-xs tracking-wider opacity-50 capitalize px-2 mb-2") #{group.title}
              nav(className="space-y-0.5")
                each item in group.items key item.href
                  SidebarItem(href={item.href} icon={item.icon} label={item.label} value={item.value} path={String(path)} onNavigate={navigate})

          div(className="bg-[#0a0a0a] border border-[#1a1a1a] rounded-xs p-3")
            div(className="text-[11px] font-mono tracking-wide text-[#888]") SIDEBAR
            div(className="text-[12px] text-[#666] leading-relaxed mt-1") Toggle with header button. Move left ↔ right. Full-width layout.
            div(className="flex gap-1.5 mt-3")
              button(className="flex-1 px-2.5 py-1.5 rounded-xs bg-white text-black text-[11px] font-mono font-medium hover:bg-[#ededed] transition" onClick={() => setSidebarSide(sidebarSide === "left" ? "right" : "left")}) #{sidebarSide === "left" ? "→ Right" : "← Left"}
              button(className="px-2.5 py-1.5 rounded-xs bg-black border border-[#262626] text-[#888] hover:text-white text-[11px] font-mono" onClick={() => setSidebarOpen(false)}) Hide
            div(className="flex gap-1.5 mt-2")
              button(className="flex-1 px-2.5 py-1.5 rounded-xs bg-[#111] border border-[#262626] text-[#888] hover:text-white hover:bg-[#1a1a1a] text-[11px] font-mono" onClick={toggleTheme}) #{theme === "dark" ? "☀ Light" : "☾ Dark"}
              span(className="px-2 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[10px] font-mono text-[#525252]") #{theme}
        div(className="p-3 border-t border-[#1a1a1a] shrink-0")
          div(className="flex items-center gap-2 px-2 py-2 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a]")
            div(className="w-7 h-7 rounded-xs bg-white text-black grid place-items-center font-mono font-medium text-[10px]") ◼
            div(className="flex-1 min-w-0")
              div(className="text-[12px] font-medium text-white leading-none") compelling
              div(className="text-[11px] font-mono text-[#666]") v0.0.0 · open
            div(className="w-1.5 h-1.5 rounded-xs bg-white")
    div(className="flex-1 min-w-0 flex flex-col w-full")
      if sidebarOpen
        fragment
          div(className="md:hidden sticky top-[64px] z-30 bg-black border-b border-[#1a1a1a] flex items-center gap-2 px-4 py-2 overflow-x-auto")
            a(href="/" className={path === "/" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-white text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#888] text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/"); }}) Overview
            a(href="/canvas" className={path === "/canvas" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-white text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#888] text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/canvas"); }}) Canvas
            a(href="/form" className={path === "/form" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-white text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#888] text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/form"); }}) Form
            a(href="/grid" className={path === "/grid" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-white text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#888] text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/grid"); }}) Grid
            a(href="/shell" className={path === "/shell" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-white text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#888] text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/shell"); }}) Shell
          main(className="flex-1 w-full min-w-0")
          if path === "/"
            Home()
          elseif path === "/canvas"
            CanvasDemo()
          elseif path === "/form"
            FormDemo()
          elseif path === "/grid"
            GridDemo()
          elseif path === "/shell"
            ShellDemo()
          elseif path === "/timeline"
            TimelineDemo()
          elseif path === "/worker"
            WorkerDemo()
          elseif path === "/motion"
            MotionDemo()
          elseif path === "/streaming"
            StreamingDemo()
          else
            div(className="w-full px-6 py-24")
              div(className="max-w-[640px]")
                div(className="inline-flex items-center gap-2 px-2.5 py-1 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[11px] font-mono tracking-wide text-[#888]") 404 — NOT_FOUND
                h1(className="text-[32px] font-semibold tracking-[-0.03em] mt-4 leading-none") The page does not exist.
                p(className="text-[14px] text-[#888] mt-3 leading-relaxed max-w-[480px]") The route you requested could not be found. Check the URL or try one of the demos below.
                div(className="flex flex-wrap gap-2 mt-6")
                  a(href="/canvas" className="px-4 py-2 rounded-xs bg-accent-1 text-white font-medium text-[13px] cursor-pointer hover:bg-[var(--accent-1-hover)] transition" onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/canvas"); }}) Canvas
                  a(href="/form" className="px-4 py-2 rounded-xs bg-[#0a0a0a] border border-[#262626] text-[#ededed] font-medium text-[13px] cursor-pointer hover:bg-[#111] transition" onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/form"); }}) Form
                  a(href="/grid" className="px-4 py-2 rounded-xs bg-[#0a0a0a] border border-[#262626] text-[#ededed] font-medium text-[13px] cursor-pointer hover:bg-[#111] transition" onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/grid"); }}) Grid
                  a(href="/shell" className="px-4 py-2 rounded-xs bg-[#0a0a0a] border border-[#262626] text-[#ededed] font-medium text-[13px] cursor-pointer hover:bg-[#111] transition" onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/shell"); }}) Shell
          footer(className="border-t border-[#1a1a1a] mt-auto w-full")
            div(className="w-full px-6 py-6 flex flex-col md:flex-row gap-4 items-start md:items-center justify-between")
              div(className="flex items-center gap-3")
                div(className="w-7 h-7 rounded-xs bg-white text-black grid place-items-center font-mono font-medium text-[10px]") ◼
                div
                  div(className="text-[13px] font-medium tracking-[-0.01em] text-white") Compelling — Beast · TSRX · Octane
                  div(className="text-[12px] font-mono text-[#666]") © 2025 Sound Rack. Vite SPA routing. Deployed on Vercel.
              div(className="flex items-center gap-4 text-[12px] font-mono text-[#666]")
                a(href="https://beast-docs.vercel.app" target="_blank" rel="noreferrer" className="hover:text-white transition") beast-tsrx
                span(className="text-[#262626]") /
                a(href="https://octanejs.dev" target="_blank" rel="noreferrer" className="hover:text-white transition") octane
                span(className="text-[#262626]") /
                a(href="https://tsrx.dev" target="_blank" rel="noreferrer" className="hover:text-white transition") tsrx
                span(className="hidden sm:inline-flex items-center gap-1.5 ml-2 pl-4 border-l border-[#1a1a1a]")
                  span(className="w-1.5 h-1.5 rounded-xs bg-accent-2 inline-block")
                  span(className="text-[#888]") All systems operational
      else
        fragment
          div(className="md:hidden sticky top-[64px] z-30 bg-black border-b border-[#1a1a1a] flex items-center gap-2 px-4 py-2 overflow-x-auto")
            a(href="/" className={path === "/" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-white text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#888] text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/"); }}) Overview
            a(href="/canvas" className={path === "/canvas" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-white text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#888] text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/canvas"); }}) Canvas
            a(href="/form" className={path === "/form" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-white text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#888] text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/form"); }}) Form
            a(href="/grid" className={path === "/grid" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-white text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#888] text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/grid"); }}) Grid
            a(href="/shell" className={path === "/shell" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-white text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#888] text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/shell"); }}) Shell
          main(className="flex-1 w-full min-w-0")
          if path === "/"
            Home()
          elseif path === "/canvas"
            CanvasDemo()
          elseif path === "/form"
            FormDemo()
          elseif path === "/grid"
            GridDemo()
          elseif path === "/shell"
            ShellDemo()
          elseif path === "/timeline"
            TimelineDemo()
          elseif path === "/worker"
            WorkerDemo()
          elseif path === "/motion"
            MotionDemo()
          elseif path === "/streaming"
            StreamingDemo()
          else
            div(className="w-full px-6 py-24")
              div(className="max-w-[640px]")
                div(className="inline-flex items-center gap-2 px-2.5 py-1 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[11px] font-mono tracking-wide text-[#888]") 404 — NOT_FOUND
                h1(className="text-[32px] font-semibold tracking-[-0.03em] mt-4 leading-none") The page does not exist.
                p(className="text-[14px] text-[#888] mt-3 leading-relaxed max-w-[480px]") The route you requested could not be found. Check the URL or try one of the demos below.
                div(className="flex flex-wrap gap-2 mt-6")
                  a(href="/canvas" className="px-4 py-2 rounded-xs bg-accent-1 text-white font-medium text-[13px] cursor-pointer hover:bg-[var(--accent-1-hover)] transition" onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/canvas"); }}) Canvas
                  a(href="/form" className="px-4 py-2 rounded-xs bg-[#0a0a0a] border border-[#262626] text-[#ededed] font-medium text-[13px] cursor-pointer hover:bg-[#111] transition" onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/form"); }}) Form
                  a(href="/grid" className="px-4 py-2 rounded-xs bg-[#0a0a0a] border border-[#262626] text-[#ededed] font-medium text-[13px] cursor-pointer hover:bg-[#111] transition" onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/grid"); }}) Grid
                  a(href="/shell" className="px-4 py-2 rounded-xs bg-[#0a0a0a] border border-[#262626] text-[#ededed] font-medium text-[13px] cursor-pointer hover:bg-[#111] transition" onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/shell"); }}) Shell
          footer(className="border-t border-[#1a1a1a] mt-auto w-full")
            div(className="w-full px-6 py-6 flex flex-col md:flex-row gap-4 items-start md:items-center justify-between")
              div(className="flex items-center gap-3")
                div(className="w-7 h-7 rounded-xs bg-white text-black grid place-items-center font-mono font-medium text-[10px]") ◼
                div
                  div(className="text-[13px] font-medium tracking-[-0.01em] text-white") Compelling — Beast · TSRX · Octane
                  div(className="text-[12px] font-mono text-[#666]") © 2025 Sound Rack. Vite SPA routing. Deployed on Vercel.
              div(className="flex items-center gap-4 text-[12px] font-mono text-[#666]")
                a(href="https://beast-docs.vercel.app" target="_blank" rel="noreferrer" className="hover:text-white transition") beast-tsrx
                span(className="text-[#262626]") /
                a(href="https://octanejs.dev" target="_blank" rel="noreferrer" className="hover:text-white transition") octane
                span(className="text-[#262626]") /
                a(href="https://tsrx.dev" target="_blank" rel="noreferrer" className="hover:text-white transition") tsrx
                span(className="hidden sm:inline-flex items-center gap-1.5 ml-2 pl-4 border-l border-[#1a1a1a]")
                  span(className="w-1.5 h-1.5 rounded-xs bg-accent-2 inline-block")
                  span(className="text-[#888]") All systems operational
    if sidebarSide === "right" && sidebarOpen
      aside(className="hidden md:flex w-[256px] shrink-0 bg-black border-l border-[#1a1a1a] flex-col sticky top-[64px] h-[calc(100vh-64px)] overflow-hidden")
        div(className="flex items-center justify-between h-[44px] px-3 border-b border-[#1a1a1a] shrink-0")
          div(className="flex items-center gap-1")
            button(className="w-6 h-6 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] grid place-items-center text-[11px] text-[#666] hover:text-white hover:border-[#262626] transition" onClick={() => setSidebarOpen(false)} aria-label="Close sidebar") ×
            button(className="w-6 h-6 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] grid place-items-center text-[11px] text-[#666] hover:text-white hover:border-[#262626] transition" onClick={() => setSidebarSide("left")} aria-label="Move to left") ←
          div(className="text-[11px] font-mono tracking-wide text-[#525252]") NAVIGATION
        div(className="flex-1 overflow-y-auto p-3 space-y-6")
          each group in navGroups key group.title
            div
              div(className="text-[11px] font-mono tracking-wide text-[#525252] px-2 mb-2") #{group.title.toUpperCase()}
              nav(className="space-y-1")
                each item in group.items key item.href
                  SidebarItem(href={item.href} icon={item.icon} label={item.label} value={item.value} path={String(path)} onNavigate={navigate})
          div(className="bg-[#0a0a0a] border border-[#1a1a1a] rounded-xs p-3")
            button(className="flex-1 px-2.5 py-1.5 rounded-xs bg-white text-black text-[11px] font-mono font-medium hover:bg-[#ededed] transition" onClick={() => setSidebarSide(sidebarSide === "left" ? "right" : "left")}) #{sidebarSide === "left" ? "→ Right" : "← Left"}
            button(className="px-2.5 py-1.5 rounded-xs bg-black border border-[#262626] text-[#888] hover:text-white text-[11px] font-mono" onClick={() => setSidebarOpen(false)}) Hide
            div(className="flex gap-1.5 mt-2")
              button(className="flex-1 px-2.5 py-1.5 rounded-xs bg-[#111] border border-[#262626] text-[#888] hover:text-white hover:bg-[#1a1a1a] text-[11px] font-mono" onClick={toggleTheme}) #{theme === "dark" ? "☀ Light" : "☾ Dark"}
              span(className="px-2 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[10px] font-mono text-[#525252]") #{theme}
        div(className="p-3 border-t border-[#1a1a1a] shrink-0")
          div(className="flex items-center gap-2 px-2 py-2 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a]")
            div(className="hidden w-7 h-7 rounded-xs bg-white text-black grid place-items-center font-mono font-medium text-[10px]") ◼
            div(className="flex-1 min-w-0")
              div(className="text-[12px] font-medium text-white leading-none") compelling
              div(className="text-[11px] font-mono text-[#666]") v0.0.0 · open
            div(className="w-1.5 h-1.5 rounded-xs bg-white")
  if sidebarOpen
    div(className="md:hidden fixed inset-0 z-40 flex")
      div(className="flex-1 bg-black/60 backdrop-blur-sm" onClick={() => setSidebarOpen(false)})
      aside(className={"w-[280px] bg-black border-[#1a1a1a] flex flex-col h-full overflow-hidden " + (sidebarSide === "left" ? "border-r order-first" : "border-l order-last")})
        div(className="flex items-center justify-between h-[64px] px-4 border-b border-[#1a1a1a] shrink-0")
          div(className="flex items-center gap-2")
            div(className="w-7 h-7 rounded-xs bg-white text-black grid place-items-center font-mono font-medium text-[10px]") ◼
            div(className="text-[13px] font-medium text-white") compelling
          button(className="w-7 h-7 rounded-xs bg-[#111] border border-[#262626] grid place-items-center text-[#888]" onClick={() => setSidebarOpen(false)}) ×
        div(className="flex items-center gap-1 p-2 border-b border-[#1a1a1a]")
          button(className={sidebarSide === "left" ? "flex-1 px-3 py-1.5 rounded-xs bg-white text-black text-[12px] font-mono font-medium" : "flex-1 px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#666] text-[12px] font-mono"} onClick={() => setSidebarSide("left")}) Left
          button(className={sidebarSide === "right" ? "flex-1 px-3 py-1.5 rounded-xs bg-white text-black text-[12px] font-mono font-medium" : "flex-1 px-3 py-1.5 rounded-xs bg-[#0a0a0a] border border-[#1a1a1a] text-[#666] text-[12px] font-mono"} onClick={() => setSidebarSide("right")}) Right
          button(className="px-3 py-1.5 rounded-xs bg-[#111] border border-[#262626] text-[#888] text-[12px] font-mono" onClick={toggleTheme}) #{theme === "dark" ? "☀" : "☾"}
        div(className="flex-1 overflow-y-auto p-3 space-y-6")
          each group in navGroups key group.title
            div
              div(className="text-[11px] font-mono tracking-wide text-[#525252] px-2 mb-2") #{group.title.toUpperCase()}
              nav(className="space-y-1")
                each item in group.items key item.href
                  SidebarItem(href={item.href} icon={item.icon} label={item.label} value={item.value} path={String(path)} onNavigate={(href: string) => { setSidebarOpen(false); navigate(href); }})
