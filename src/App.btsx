import Home from "./pages/home.btsx"
import Brand from "./components/ui/brand.btsx"
import Button from "./components/ui/button.btsx"
import ButtonGroup from "./components/ui/button-group.btsx"
import PrimaryButton from "./components/ui/primary-button.btsx"
import Tag from "./components/ui/tag.btsx"
import SidebarItem from "./components/ui/sidebar/sidebar-item.btsx"
import { navGroups } from "./components/ui/sidebar/navs"
import Icon from "./lib/icons/index.btsx"
import { cn } from "./lib/utils"
import { lazy, Suspense, useEffect, useState } from "octane"
import { applyTheme, getStoredTheme, getSystemTheme } from "./lib/theme"

module
  const CanvasDemo = lazy(() => import("./demos/canvas.btsx"))
  const FormDemo = lazy(() => import("./demos/form.btsx"))
  const GridDemo = lazy(() => import("./demos/grid.btsx"))
  const ShellDemo = lazy(() => import("./demos/shell.btsx"))
  const TimelineDemo = lazy(() => import("./demos/timeline.btsx"))
  const WorkerDemo = lazy(() => import("./demos/worker.btsx"))
  const MotionDemo = lazy(() => import("./demos/motion.btsx"))
  const StreamingDemo = lazy(() => import("./demos/streaming.btsx"))
  const TableDemo = lazy(() => import("./demos/table.btsx"))

setup
  const [sidebarOpen, setSidebarOpen] = useState(true)
  const [sidebarSide, setSidebarSide] = useState<"left" | "right">("left")
  const [path, setPath] = useState(typeof window !== "undefined" ? window.location.pathname : "/")
  const [theme, setTheme] = useState<"dark" | "light">(() => {
      if (typeof document !== "undefined" && document.documentElement.classList.contains("dark")) return "dark";
      if (typeof window !== "undefined") return getStoredTheme() ?? getSystemTheme();
      return "light";
    })

  const navigate = (to: string) => (e: MouseEvent) => {
    e.preventDefault()
    if (to !== window.location.pathname) {
      window.history.pushState(null, "", to)
      setPath(to)
      window.scrollTo(0, 0)
    }
  }
  useEffect(() => {
    const onPop = () => setPath(window.location.pathname)
    window.addEventListener("popstate", onPop)
    const onClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement
      const anchor = target.closest("a")
      if (anchor instanceof HTMLAnchorElement && anchor.href.startsWith(window.location.origin) && anchor.target !== "_blank" && anchor.hasAttribute("href")) {
        const url = new URL(anchor.href)
        if (url.pathname !== window.location.pathname) {
          e.preventDefault()
          window.history.pushState(null, "", url.pathname + url.search + url.hash)
          setPath(url.pathname)
          window.scrollTo(0, 0)
        }
      }
    }
    document.addEventListener("click", onClick)
    return () => {
      window.removeEventListener("popstate", onPop)
      document.removeEventListener("click", onClick)
    }
  }, [])
  useEffect(() => {
    const mq = window.matchMedia("(max-width: 768px)")
    const apply = () => setSidebarOpen(!mq.matches)
    apply()
    const handler = () => apply()
    mq.addEventListener("change", handler)
    return () => mq.removeEventListener("change", handler)
  }, [])
  useEffect(() => {
    applyTheme(theme)
  }, [theme])
  const toggleTheme = () => setTheme(theme === "dark" ? "light" : "dark")
  const setSideFn = (side: "left" | "right") => (e: MouseEvent) => {
    e.preventDefault()
    setSidebarSide(side)
  }
  const toggleSidebar = (e: MouseEvent) => {
    e.preventDefault()
    setSidebarOpen(!sidebarOpen)
  }


component Topbar
  props { path, navigate, toggleTheme, setSideFn, toggleSidebar }: { path: string, navigate: (to: string) => (event: MouseEvent) => void, toggleTheme: VoidFunction, setSideFn: (event: MouseEvent) => void, toggleSidebar: (event: MouseEvent) => void }
  setup
    const navs = navGroups[0].items

  header(className="sticky top-0 z-40 backdrop-blur-3xl border-b border-border/30 w-full")
    div(className="w-full px-4 flex items-center justify-between h-[64px] gap-4")
      Brand(imageUrl="https://res.cloudinary.com/dx0heqhhe/image/upload/v1787232482/compelling-beast_han49i.svg")
        div(className="hidden md:flex items-center")
          button(className="size-6 aspect-square rounded-none rounded-s-md border border-r-0 border-input grid place-items-center text-muted-foreground/70 hover:text-foreground hover:border-input transition" onClick={setSideFn} aria-label="Move to right")
            Icon(name="arrow-right" className="" size={14})
          button(className="size-6 aspect-square rounded-none rounded-e-md border border-input grid place-items-center text-muted-foreground/70 hover:text-foreground hover:border-input transition" onClick={toggleSidebar} aria-label="Close sidebar")
            Icon(name="close-small" className="" size={14})
      nav(className="hidden lg:flex items-center gap-1")
        each nav in navs key nav.href
          Tag(href={nav.href} target="_self" variant={path === nav.href ? "secondary" : "ghost"} label={nav.label} onClick={navigate(nav.href)})
      div(className="flex items-center gap-2")
        Button(size='icon' icon='theme' iconStyle='md:size-5 size-6' variant='ghost' onClick={toggleTheme} aria-label="Toggle theme")
        Button(size='icon' icon='chevron-down' variant='secondary' onClick={toggleTheme} aria-label="more" className="hidden")
        PrimaryButton(label="Docs" tone='dark' size="sm" type='a' href='https://beast-docs.vercel.app' target="_blank" rel="noopener noreferrer" className="hidden md:flex")

component LeftSidebar
  props { sidebarOpen, navGroups, path, navigate }: { sidebarOpen: boolean, navGroups: NavGroup[], setSideFn: (side: "left" | "right") => void, toggleSidebar: VoidFunction, path: string, navigate: (to: string) => void  }
  aside(className="hidden md:flex w-[256px] shrink-0 border-r border-border/0 flex-col sticky top-[64px] h-[calc(100vh-64px)] overflow-hidden")
    div(className="flex-1 overflow-y-auto p-3 space-y-6")
      each group in navGroups
        div(key={group.title})
          div(className="text-xs tracking-wider opacity-50 capitalize px-2 mb-2") #{group.title}
          nav(className="space-y-0.5")
            each item in group.items key item.href
              SidebarItem(href={item.href} icon={item.icon} label={item.label} value={item.value} path={String(path)} onNavigate={navigate(item.href)})
      div(className="bg-card border border-border rounded-xs p-3")

    div(className=" border-border shrink-0")
      div(className="flex items-center h-22 gap-2 px-2 rounded-xs bg-card")
        div(className="size-7 aspect-square rounded-xl bg-primary/50 text-primary-foreground grid place-items-center font-mono font-medium text-[10px]")
        div(className="flex-1 min-w-0")
          div(className="text-[12px] font-medium text-foreground leading-none")
          div(className="text-[11px] font-mono text-muted-foreground") v0.2.7

component Footer
  footer(className="border-t border-border/30 mt-auto w-full")
    div(className="w-full px-6 py-6 flex items-center justify-between gap-4 font-mono text-muted-foreground text-[11px] uppercase")
      div(className="flex items-center gap-3")
        div
          div(className="font-mono text-xs text-border") ©2026 Beast
      div(className="flex items-center gap-4")
        a(href="https://beast-docs.vercel.app" target="_blank" rel="noreferrer" className="hover:text-foreground transition") DOCS
        a(href="https://github.com/phtn/beast" target="_blank" rel="noreferrer" className="inline-flex items-center gap-1.5 ml-0 pl-4 border-l border-input")
          Icon(name="github" className="text-muted-foreground")

component MainContent
  props { path, navigate, fallback }: { path: string, navigate: (to: string) => (event: MouseEvent) => void, fallback: string }
  main(className="flex-1 w-full min-w-0")
    Suspense(fallback={fallback})
      if path === "/"
        Home()
      elseif path === "/canvas"
        CanvasDemo()
      elseif path === "/form"
        FormDemo()
      elseif path === "/grid"
        GridDemo()
      elseif path === "/shell"
        ShellDemo()
      elseif path === "/timeline"
        TimelineDemo()
      elseif path === "/worker"
        WorkerDemo()
      elseif path === "/motion"
        MotionDemo()
      elseif path === "/streaming"
        StreamingDemo()
      elseif path === "/table"
        TableDemo()
      else
        div(className="w-full px-6 py-24")
          div(className="max-w-[640px]")
            div(className="inline-flex items-center gap-2 px-2.5 py-1 rounded-xs bg-card border border-border/50 text-[11px] font-mono tracking-wide text-muted-foreground") 404 — NOT_FOUND
            h1(className="text-[32px] font-semibold tracking-[-0.03em] mt-4 leading-none") The page does not exist.
            p(className="text-[14px] text-muted-foreground mt-3 leading-relaxed max-w-[480px]") The route you requested could not be found. Check the URL or try one of the demos below.
            div(className="flex flex-wrap gap-2 mt-6")
              a(href="/canvas" className="px-4 py-2 rounded-xs bg-accent-1 text-foreground font-medium text-[13px] cursor-pointer hover:bg-primary transition" onClick={navigate("/canvas")}) Canvas
              a(href="/form" className="px-4 py-2 rounded-xs bg-card border border-input text-foreground font-medium text-[13px] cursor-pointer hover:bg-muted transition" onClick={navigate("/form")}) Form
              a(href="/grid" className="px-4 py-2 rounded-xs bg-card border border-input text-foreground font-medium text-[13px] cursor-pointer hover:bg-muted transition" onClick={navigate("/grid")}) Grid
              a(href="/shell" className="px-4 py-2 rounded-xs bg-card border border-input text-foreground font-medium text-[13px] cursor-pointer hover:bg-muted transition" onClick={navigate("/shell")}) Shell

div(className="min-h-screen text-foreground selection:bg-primary selection:text-primary-foreground antialiased")
  Topbar(path={path} navigate={navigate} toggleTheme={toggleTheme} setSideFn={setSideFn('right')} toggleSidebar={toggleSidebar})
  div(className="flex w-full min-h-[calc(100vh-64px)]")
    if sidebarSide === "left" && sidebarOpen
      LeftSidebar(sidebarOpen={sidebarOpen} navGroups={navGroups} setSideFn={setSideFn('right')} toggleSidebar={toggleSidebar} path={path} navigate={navigate})
    div(className="flex-1 min-w-0 flex flex-col w-full")
      if sidebarOpen
        fragment
          div(className="hidden sticky top-[64px] z-30 bg-background border-b border-border/50 flex items-center gap-2 px-4 py-2 overflow-x-auto")
            a(href="/" className={path === "/" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-foreground text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/"); }}) Overview
            a(href="/canvas" className={path === "/canvas" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-foreground text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/canvas"); }}) Canvas
            a(href="/form" className={path === "/form" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-foreground text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/form"); }}) Form
            a(href="/grid" className={path === "/grid" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-foreground text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/grid"); }}) Grid
            a(href="/shell" className={path === "/shell" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-foreground text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/shell"); }}) Shell

          // MAIN
          MainContent(path={path} navigate={navigate} fallback="")
          Footer
      else
        fragment
          ButtonGroup(className="w-screen hidden _flex-nowrap justify-evenly border-0 overflow-scroll whitespace-nowrap bg-border/10 rounded-xs")
            each nav in navGroups[0].items key nav.href
              Tag(size='sm' onClick={navigate(nav.href)} className={path === nav.href ? 'bg-border/20 border border-border/30' : `border border-border/0`} variant="outline" attached={true} label={ nav.label})
              // a(href="/" className={path === "/" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-foreground text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/"); }}) Overvie
              // a(href="/canvas" className={path === "/canvas" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-foreground text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/canvas"); }}) Canvas
              // a(href="/form" className={path === "/form" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-foreground text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/form"); }}) Form
              // a(href="/grid" className={path === "/grid" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-foreground text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/grid"); }}) Grid
              // a(href="/shell" className={path === "/shell" ? "px-3 py-1.5 rounded-xs bg-accent-1 text-foreground text-[12px] font-medium border border-accent-1 whitespace-nowrap" : "px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[12px] font-mono whitespace-nowrap"} onClick={(e: MouseEvent) => { e.preventDefault(); navigate("/shell"); }}) Shell
          MainContent(path={path} navigate={navigate} fallback="Loading demo…")
          Footer
    if sidebarSide === "right" && sidebarOpen
      aside(className="hidden md:flex w-[256px] shrink-0 bg-background border-l border-border/50 flex-col sticky top-[64px] h-[calc(100vh-64px)] overflow-hidden")
        div(className="flex items-center justify-between h-[44px] px-3 border-b border-border shrink-0")
          div(className="flex items-center gap-1")
            button(className="w-6 h-6 rounded-xs bg-card border border-border grid place-items-center text-[11px] text-muted-foreground hover:text-foreground hover:border-input transition" onClick={() => setSidebarOpen(false)} aria-label="Close sidebar") ×
            button(className="w-6 h-6 rounded-xs bg-card border border-border grid place-items-center text-[11px] text-muted-foreground hover:text-foreground hover:border-input transition" onClick={() => setSidebarSide("left")} aria-label="Move to left") ←
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") NAVIGATION
        div(className="flex-1 overflow-y-auto p-3 space-y-6")
          each group in navGroups key group.title
            div
              div(className="text-[11px] font-mono tracking-wide text-muted-foreground px-2 mb-2") #{group.title.toUpperCase()}
              nav(className="space-y-1")
                each item in group.items key item.href
                  SidebarItem(href={item.href} icon={item.icon} label={item.label} value={item.value} path={String(path)} onNavigate={navigate(item.href)})
          div(className="flex items-center gap-2 px-2 py-2 rounded-xs bg-card border border-border")
            div(className="hidden w-7 h-7 rounded-xs bg-primary text-primary-foreground grid place-items-center font-mono font-medium text-[10px]") ◼
            div(className="flex-1 min-w-0")
              div(className="text-[12px] font-medium text-foreground leading-none")
              div(className="text-[11px] font-mono text-muted-foreground") v0.1.1
            div(className="w-1.5 h-1.5 rounded-xs bg-primary")
  if sidebarOpen
    div(className="fixed inset-0 z-40 md:hidden ")
      div(className="flex-1 bg-background/60 backdrop-blur-sm" onClick={() => setSidebarOpen(false)})
      aside(className={"w-[280px] bg-background border-border/30 flex flex-col h-full overflow-hidden " + (sidebarSide === "left" ? "border-r order-first" : "border-l order-last")})
        div(className="flex items-center justify-between h-[64px] px-4 border-b border-border shrink-0")
          button(className="w-7 h-7 rounded-xs bg-muted border border-input grid place-items-center text-muted-foreground" onClick={() => setSidebarOpen(false)}) ×
        div(className="flex items-center gap-1 p-2 border-b border-border")
          button(className="px-3 py-1.5 rounded-xs bg-muted border border-input text-muted-foreground text-[12px] font-mono" onClick={toggleTheme}) #{theme === "dark" ? "☀" : "☾"}
        div(className="flex-1 overflow-y-auto p-3 space-y-6")
          each group in navGroups key group.title
            div
              div(className="text-[11px] font-mono tracking-wide text-muted-foreground px-2 mb-2") #{group.title.toUpperCase()}
              nav(className="space-y-1")
                each item in group.items key item.href
                  SidebarItem(href={item.href} icon={item.icon} label={item.label} value={item.value} path={String(path)} onNavigate={(event: MouseEvent) => { setSidebarOpen(false); navigate(item.href)(event); }})
