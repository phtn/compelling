import { cn } from "@/lib/utils"
import Icon from "@/lib/icons/index.btsx"
import { useEffect, useId, useRef, useState } from "octane"

module
  export type SelectSize = "sm" | "lg"

  export interface SelectItem {
    value: string
    label: string
    disabled?: boolean
  }

  export interface SelectProps {
    value?: string
    size?: SelectSize
    defaultValue?: string
    placeholder?: string
    label?: string
    disabled?: boolean
    items: readonly SelectItem[]
    onValueChange?: (value: string) => void
    className?: string
    triggerClassName?: string
    contentClassName?: string
  }

  const SELECT_ROOT_CLASS = "relative inline-flex w-full flex-col gap-1.5"
  const SELECT_LABEL_CLASS = "text-[11px] font-medium tracking-wide text-muted-foreground"
  const SELECT_TRIGGER_CLASS = "inline-flex w-full shrink-0 items-center justify-between gap-2 rounded-[10px] border px-3 text-[12px] font-medium leading-4 transition-colors"
  const SELECT_CONTENT_CLASS = "absolute left-0 top-full z-50 mt-1 max-h-60 w-full overflow-auto rounded-[10px] border border-[#E2E2E2] bg-[#FCFCFC] p-1 shadow-[0_1px_4px_-4px_#00000013,0_8px_16px_-12px_#00000020] dark:border-border dark:bg-popover"
  const SELECT_OPTION_CLASS = "mt-1 flex cursor-pointer items-center rounded-[8px] px-2 py-2 text-[12px] font-medium leading-4 transition-colors"

  const SELECT_SIZE_CLASSES = {
    sm: "h-9",
    lg: "h-10",
  } as const satisfies Record<SelectSize, string>

props { value, size = "sm", defaultValue, placeholder = "Select...", label, disabled, items, onValueChange, className, triggerClassName, contentClassName }: SelectProps

setup
  const [open, setOpen] = useState(false)
  const [internalValue, setInternalValue] = useState(defaultValue ?? "")
  const containerRef = useRef<HTMLDivElement | null>(null)
  const triggerId = useId()
  const labelId = `${triggerId}-label`
  const listboxId = `${triggerId}-listbox`
  const selectedValue = value !== undefined ? value : internalValue
  const selectedItem = items.find((i) => i.value === selectedValue)
  const selectedLabel = selectedItem?.label
  const triggerStateClass = open ? "bg-[#FCFCFC] border-[#E2E2E2] dark:bg-card dark:border-border" : "bg-[#F1F1F1] border-[#ECECEC] dark:bg-muted dark:border-border"
  const resolvedTriggerClassName = cn(SELECT_TRIGGER_CLASS, SELECT_SIZE_CLASSES[size], triggerStateClass, disabled && "pointer-events-none opacity-50", triggerClassName)

  const handleSelect = (next: string) => {
    if (value === undefined) setInternalValue(next)
    onValueChange?.(next)
    setOpen(false)
  }

  useEffect(() => {
    if (!open) return
    const handleDocumentMouseDown = (event: MouseEvent) => {
      const container = containerRef.current
      if (container && !container.contains(event.target as Node)) setOpen(false)
    }
    const handleDocumentKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape") setOpen(false)
    }
    document.addEventListener("mousedown", handleDocumentMouseDown)
    document.addEventListener("keydown", handleDocumentKeyDown)
    return () => {
      document.removeEventListener("mousedown", handleDocumentMouseDown)
      document.removeEventListener("keydown", handleDocumentKeyDown)
    }
  }, [open])

div(ref={containerRef} className={cn(SELECT_ROOT_CLASS, className)})
  if label
    label(id={labelId} for={triggerId} className={SELECT_LABEL_CLASS}) #{label}
  button(id={triggerId} type="button" disabled={disabled} aria-expanded={open} aria-haspopup="listbox" aria-controls={listboxId} className={resolvedTriggerClassName} onClick={() => setOpen((current) => !current)})
    span(className={cn("truncate flex-1 text-left", selectedValue ? "text-[#121212] dark:text-foreground" : "text-[#7B7B7B] dark:text-muted-foreground")}) #{selectedLabel ?? placeholder}
    Icon(name="chevron-down-tiny" size={16} className={cn("ml-auto shrink-0 text-[#7B7B7B] transition-transform duration-200", open && "rotate-180")})
  if open
    div(id={listboxId} role="listbox" aria-labelledby={label ? labelId : triggerId} className={cn(SELECT_CONTENT_CLASS, contentClassName)})
      each item in items key item.value
        div(role="option" aria-selected={selectedValue === item.value} aria-disabled={item.disabled} className={cn(SELECT_OPTION_CLASS, selectedValue === item.value ? "bg-[#F1F1F1] text-[#121212] dark:bg-muted dark:text-foreground" : "bg-transparent text-[#7B7B7B] hover:bg-[#F1F1F1] hover:text-[#121212] dark:text-muted-foreground dark:hover:bg-muted dark:hover:text-foreground", item.disabled && "pointer-events-none opacity-50")} onClick={() => !item.disabled && handleSelect(item.value)})
          span(className="truncate") #{item.label}
