import { cn } from "@/lib/utils"
import Icon from "@/lib/icons/index.btsx"
import { useEffect, useRef, useState } from "octane"

module
  interface SelectItem {
    value: string;
    label: string;
    disabled?: boolean;
  }

  interface SelectProps {
    value?: string;
    defaultValue?: string;
    placeholder?: string;
    label?: string;
    disabled?: boolean;
    items: SelectItem[];
    onValueChange?: (value: string) => void;
    className?: string;
    triggerClassName?: string;
    contentClassName?: string;
  }

props { value, defaultValue, placeholder = "Select...", label, disabled, items = [], onValueChange, className, triggerClassName, contentClassName }: SelectProps

setup
  const [open, setOpen] = useState(false)
  const [internalValue, setInternalValue] = useState(value ?? defaultValue ?? "")
  const containerRef = useRef<HTMLDivElement | null>(null)
  const selectedValue = value !== undefined ? value : internalValue
  const selectedItem = items.find((i) => i.value === selectedValue)
  const selectedLabel = selectedItem?.label

  const handleSelect = (next: string) => {
    if (value === undefined) setInternalValue(next)
    onValueChange?.(next)
    setOpen(false)
  }

  useEffect(() => {
    if (value !== undefined) setInternalValue(value)
  }, [value])

  useEffect(() => {
    if (!open) return
    const onDown = (e: MouseEvent) => {
      const el = containerRef.current
      if (el && !el.contains(e.target as Node)) setOpen(false)
    }
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") setOpen(false)
    }
    document.addEventListener("mousedown", onDown)
    document.addEventListener("keydown", onKey)
    return () => {
      document.removeEventListener("mousedown", onDown)
      document.removeEventListener("keydown", onKey)
    }
  }, [open])

div(ref={containerRef} className={cn("relative inline-flex flex-col gap-1.5 w-full max-w-[128px]", className)})
  if label
    label(className="text-[11px] font-medium tracking-wide text-muted-foreground") #{label}
  button(type="button" disabled={disabled} aria-expanded={open} aria-haspopup="listbox" className={cn("inline-flex items-center justify-between w-full h-9 px-3 rounded-[10px] border text-[12px] font-medium leading-4 transition-colors gap-2 shrink-0", open ? "bg-[#FCFCFC] border-[#E2E2E2] dark:bg-card dark:border-border" : "bg-[#F1F1F1] border-[#ECECEC] dark:bg-muted dark:border-border", disabled && "opacity-50 pointer-events-none", triggerClassName)} onClick={() => setOpen(!open)})
    span(className={cn("truncate flex-1 text-left", selectedValue ? "text-[#121212] dark:text-foreground" : "text-[#7B7B7B] dark:text-muted-foreground")}) #{selectedLabel ?? placeholder}
    Icon(name="chevron-down-tiny" size={16} className={cn("ml-auto shrink-0 text-[#7B7B7B] transition-transform duration-200", open && "rotate-180")})
  if open
    div(role="listbox" className={cn("absolute top-full left-0 w-full mt-1 bg-[#FCFCFC] dark:bg-popover border border-[#E2E2E2] dark:border-border rounded-[10px] p-1 shadow-[0_1px_4px_-4px_#00000013,0_8px_16px_-12px_#00000020] z-50 max-h-60 overflow-auto", contentClassName)})
      each item in items key item.value
        div(role="option" aria-selected={selectedValue === item.value} aria-disabled={item.disabled} className={cn("px-2 py-2 rounded-[8px] text-[12px] font-medium leading-4 cursor-pointer transition-colors flex items-center", selectedValue === item.value ? "bg-[#F1F1F1] text-[#121212] dark:bg-muted dark:text-foreground" : "bg-transparent text-[#7B7B7B] hover:bg-[#F1F1F1] hover:text-[#121212] dark:text-muted-foreground dark:hover:bg-muted dark:hover:text-foreground", item.disabled && "opacity-50 pointer-events-none")} onClick={() => !item.disabled && handleSelect(item.value)})
          span(className="truncate") #{item.label}
