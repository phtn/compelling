import { cn } from "@/lib/utils"
import Icon from "@/lib/icons/index.btsx"
import type { IconName } from "@/lib/icons/types"
import { useState } from "octane"

module
  export interface InputProps {
    value?: string
    defaultValue?: string
    placeholder?: string
    type?: string
    disabled?: boolean
    leftIcon?: IconName
    rightSlot?: unknown
    className?: string
    inputClassName?: string
    onChange?: (value: string) => void
    onKeyDown?: (event: KeyboardEvent) => void
    children?: unknown
  }

  const INPUT_ROOT_CLASS = "relative flex w-full items-center"
  const INPUT_ICON_CONTAINER_CLASS = "pointer-events-none absolute left-1 top-1.5 grid size-8 shrink-0 place-items-center rounded-[8px] text-[#7B7B7B]"
  const INPUT_BASE_CLASS = "h-11 w-full rounded-md border border-border/50 pl-8 pr-14 font-mono text-[12px] font-medium leading-4 tracking-[-0.12px] text-[#121212] transition-colors placeholder:font-medium placeholder:text-border/80 focus:outline-none focus-visible:bg-[#FCFCFC] focus-visible:ring-1 focus-visible:ring-[#E2E2E2] disabled:cursor-not-allowed disabled:opacity-50 dark:border-border dark:bg-muted dark:text-foreground dark:focus-visible:bg-card"
  const INPUT_SEARCH_HINT_CLASS = "pointer-events-none absolute right-[7px] top-1/2 inline-flex h-6 min-w-4 -translate-y-1/2 select-none items-center justify-center rounded-[6px] bg-input px-2 py-[2px] text-[12px] font-medium leading-none text-white dark:bg-muted-foreground dark:text-background"

props { value, defaultValue, placeholder = "Search files...", type = "text", disabled, leftIcon, rightSlot, className, inputClassName, onChange, onKeyDown, children }: InputProps

setup
  const [internalValue, setInternalValue] = useState(defaultValue ?? "")
  const isControlled = value !== undefined
  const inputValue = isControlled ? value : internalValue
  const hasTrailingContent = type === "search" || rightSlot !== undefined || children !== undefined
  const resolvedInputClassName = cn(INPUT_BASE_CLASS, !leftIcon && "pl-3", !hasTrailingContent && "pr-3", inputClassName)

  const handleInput = (event: InputEvent) => {
    const nextValue = (event.currentTarget as HTMLInputElement).value
    if (!isControlled) setInternalValue(nextValue)
    onChange?.(nextValue)
  }

div(className={cn(INPUT_ROOT_CLASS, className)})
  if leftIcon
    div(className={INPUT_ICON_CONTAINER_CLASS})
      Icon(name={leftIcon} size={18} className="m-0 text-[#7B7B7B]")
  input(type={type} value={inputValue} placeholder={placeholder} disabled={disabled} className={resolvedInputClassName} onInput={handleInput} onKeyDown={onKeyDown})
  if type === "search"
    kbd(className={INPUT_SEARCH_HINT_CLASS}) /
  | #{rightSlot}
  | #{children}
