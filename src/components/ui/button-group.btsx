import { cn } from "@/lib/utils"

module
  export type ButtonGroupOrientation = "horizontal" | "vertical"
  export type ButtonGroupVariant = "default" | "segmented"
  export type ButtonGroupSize = "sm" | "md" | "lg"

  export interface ButtonGroupProps {
    orientation?: ButtonGroupOrientation
    attached?: boolean
    variant?: ButtonGroupVariant
    size?: ButtonGroupSize
    className?: string
    children?: unknown
  }

  const BUTTON_GROUP_BASE_CLASS = "inline-flex shrink-0 items-center overflow-hidden p-1"

  const BUTTON_GROUP_ORIENTATION_CLASSES = {
    horizontal: "flex-row",
    vertical: "flex-col",
  } as const satisfies Record<ButtonGroupOrientation, string>

  const BUTTON_GROUP_SIZE_CLASSES = {
    sm: "[&>*]:h-9 [&>*]:text-[11px]",
    md: "[&>*]:h-10 [&>*]:text-[13px]",
    lg: "[&>*]:h-11 [&>*]:text-[14px]",
  } as const satisfies Record<ButtonGroupSize, string>

  const BUTTON_GROUP_ATTACHED_CLASSES = {
    horizontal: "divide-x divide-border [&>*]:rounded-none [&>*]:border-0 [&>*:first-child]:rounded-l-[11px] [&>*:last-child]:rounded-r-[11px]",
    vertical: "divide-y divide-border [&>*]:rounded-none [&>*]:border-0 [&>*:first-child]:rounded-t-[11px] [&>*:last-child]:rounded-b-[11px]",
  } as const satisfies Record<ButtonGroupOrientation, string>

props { orientation = "horizontal", attached = true, variant = "default", size = "md", className, children }: ButtonGroupProps

setup
  const variantClass = variant === "segmented" ? "rounded-xl border border-[#E2E2E2] bg-[#F1F1F1] dark:border-border dark:bg-muted" : attached ? "has-[>button]:gap-0 overflow-hidden rounded-xl border border-border" : "gap-1"
  const buttonGroupClassName = cn(BUTTON_GROUP_BASE_CLASS, BUTTON_GROUP_ORIENTATION_CLASSES[orientation], variantClass, BUTTON_GROUP_SIZE_CLASSES[size], attached && BUTTON_GROUP_ATTACHED_CLASSES[orientation], className)

div(className={buttonGroupClassName})
  | #{children}
