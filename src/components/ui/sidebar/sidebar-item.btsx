import { cn } from "@/lib/utils";
import Icon from "@/lib/icons/index.btsx";
import type { IconName } from "@/lib/icons/types";

module
  interface Props {
    href: string;
    icon: IconName;
    label: string;
    value: string | number | HTMLElement;
    path: string;
    onNavigate: (href: string) => void;
  }

props {href, icon, label, value, path, onNavigate}: Props

setup
  const isExternal = href.startsWith("http")
  const handleClick = (e: MouseEvent) => {
    if (!isExternal) {
      e.preventDefault();
      onNavigate(href);
    }
  }

a(href={href} className={cn('w-full h-10 flex items-center ps-0.5 pe-3 font-medium rounded-xl border-0 hover:bg-[#ECECEC85]', {'bg-[#F1f1f1] border-[#ECECEC] dark:bg-mist-400/25': path === href})} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noreferrer" : undefined} onClick={handleClick})
  Icon(name={icon} className={cn("mr-3 p-1.5 text-[#7b7b7b]", {'rounded-lg text-[#171717] bg-white invert shadow-xs': path === href})})
  span(className="font-medium text-[12px] opacity-90") #{label}
  span(className="w-7 opacity-80 text-sm text-right ml-auto font-mono") #{value}
