import { cn } from "@/lib/utils"
import Icon from "@/lib/icons/index.btsx"
import type { IconName } from "@/lib/icons/types"

module
  export interface SidebarItemProps {
    href: string
    icon: IconName
    label: string
    value: string | number
    path: string
    onNavigate: (event: MouseEvent) => void
  }

  const SIDEBAR_ITEM_CLASS = "flex w-full items-center gap-3 rounded-[12px] border py-[3px] pl-[3px] pr-[10px] text-left transition-colors"
  const SIDEBAR_ITEM_SELECTED_CLASS = "border-[#E2E2E2] bg-[#F1F1F1] dark:border-border/50 dark:bg-muted"
  const SIDEBAR_ITEM_DEFAULT_CLASS = "border-transparent bg-transparent hover:bg-[#F1F1F1] dark:hover:bg-muted"
  const SIDEBAR_ICON_CONTAINER_CLASS = "flex size-8 shrink-0 items-center justify-center rounded-[8px]"
  const SIDEBAR_ICON_CLASS = "m-0 text-[#7B7B7B] dark:text-[#a1a1a1]"
  const SIDEBAR_LABEL_CLASS = "flex-1 truncate font-sans text-sm font-medium leading-5 tracking-[-0.28px] text-[#7B7B7B] md:text-[14px] dark:text-[#a1a1a1]"
  const SIDEBAR_VALUE_CLASS = "ml-auto shrink-0 text-right font-mono text-2xs leading-none tabular-nums text-[#7B7B7B] dark:text-[#a1a1a1]"
  const SIDEBAR_SELECTED_TEXT_CLASS = "text-[#171717] dark:text-[#ededed]"

props { href, icon, label, value, path, onNavigate }: SidebarItemProps

setup
  const isExternal = href.startsWith("http")
  const isSelected = path === href
  const itemClassName = cn(SIDEBAR_ITEM_CLASS, isSelected ? SIDEBAR_ITEM_SELECTED_CLASS : SIDEBAR_ITEM_DEFAULT_CLASS)
  const iconContainerClassName = cn(SIDEBAR_ICON_CONTAINER_CLASS, isSelected ? "bg-[#FCFCFC] text-[#121212] shadow-[0_0_4px_rgba(18,18,18,0.10)] dark:bg-card dark:text-foreground" : "bg-transparent text-[#7B7B7B] dark:text-muted-foreground")

  const handleClick = (event: MouseEvent) => {
    if (!isExternal) {
      event.preventDefault()
      onNavigate(event)
    }
  }

a(href={href} className={itemClassName} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined} aria-current={isSelected ? "page" : undefined} onClick={handleClick})
  div(className={iconContainerClassName})
    Icon(name={icon} size={20} className={cn(SIDEBAR_ICON_CLASS, isSelected && SIDEBAR_SELECTED_TEXT_CLASS)})
  span(className={cn(SIDEBAR_LABEL_CLASS, isSelected && SIDEBAR_SELECTED_TEXT_CLASS)}) #{label}
  // span(className={cn(SIDEBAR_VALUE_CLASS, isSelected && SIDEBAR_SELECTED_TEXT_CLASS)}) #{value}
