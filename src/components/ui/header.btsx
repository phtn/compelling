import Icon from "@/lib/icons/index.btsx"
import { cn } from "@/lib/utils"
import type { IconName } from "@/lib/icons/types"
import Button from "./button.btsx"
import type { ButtonSize, ButtonVariant } from "./button.btsx"
import ButtonGroup from "./button-group.btsx"

module
  export interface HeaderAction {
    id: string
    label?: string
    icon?: IconName
    href?: string
    variant?: ButtonVariant
    size?: ButtonSize
    className?: string
    onClick?: (event: MouseEvent) => void
  }

  export interface HeaderProps {
    title: string
    subtitle?: string
    description?: string
    icon?: IconName
    isVisible?: boolean
    toggleFn?: VoidFunction
    pending?: boolean
    pendingLabel?: string
    actions?: readonly HeaderAction[]
    className?: string
    actionsClassName?: string
    children?: unknown
  }

  const HEADER_CLASS = "flex items-start justify-between gap-4 pb-5"
  const HEADER_DESCRIPTION_CLASS = "mt-2 flex max-w-2xl font-mono text-[13px] leading-relaxed text-muted-foreground"
  const HEADER_ACTION_LINK_CLASS = "inline-flex h-9 items-center justify-center gap-2 px-3 text-[12px] font-medium transition"
  const HEADER_ACTION_DEFAULT_CLASS = "bg-card border-input text-muted-foreground hover:bg-muted hover:text-foreground"
  const HEADER_ACTION_FALLBACK_CLASS = "flex h-9 items-center justify-center gap-2 rounded-[10px] px-3 font-mono text-[11px]"
  const HEADER_PENDING_CLASS = "flex h-9 items-center gap-2 rounded-[10px] border border-border bg-card px-3 py-1.5 font-mono text-[11px] text-muted-foreground"
  const HEADER_PENDING_DOT_CLASS = "h-1.5 w-1.5 rounded-full bg-foreground"

props { title, subtitle, description, icon, isVisible = true, toggleFn, pending, pendingLabel, actions = [], className, actionsClassName, children }: HeaderProps

div(className={cn(HEADER_CLASS, className)})
  div(className="flex flex-col gap-3 min-w-0 flex-1")
    h1(className="font-semibold text-4xl tracking-tighter text-foreground") #{title}
    if subtitle || toggleFn
      div(className="group flex items-center gap-1.5 h-5 text-2xs opacity-70 hover:opacity-100 tracking-widest uppercase text-muted-foreground")
        if subtitle
          span(className="group-hover:opacity-50") #{subtitle}
        if toggleFn
          button(type="button" className="cursor-pointer" aria-label="Toggle header details" aria-expanded={isVisible} onClick={toggleFn})
            Icon(name={icon ?? "overview"} className="text-blue-500 group-hover:rotate-60 transition-all duration-500 ease-in-out")
    if description
      p(className={cn(HEADER_DESCRIPTION_CLASS, !isVisible && "hidden")}) #{description}
    | #{children}
  if pending !== undefined || actions.length > 0
    div(className="flex flex-wrap gap-3 items-center shrink-0")
      if pending !== undefined
        div(className={HEADER_PENDING_CLASS})
          div(className={cn(HEADER_PENDING_DOT_CLASS, pending && "animate-pulse")})
          span #{pending ? (pendingLabel ?? "Saving...") : "Saved"}
      if actions.length > 0
        ButtonGroup(variant="default" size="sm" className={cn("flex", actionsClassName)})
          each action in actions key action.id
            if action.href
              a(href={action.href} className={cn(HEADER_ACTION_LINK_CLASS, action.className ?? HEADER_ACTION_DEFAULT_CLASS)} target={action.href.startsWith("http") ? "_blank" : undefined} rel={action.href.startsWith("http") ? "noopener noreferrer" : undefined} onClick={action.onClick})
                if action.icon
                  Icon(name={action.icon})
                if action.label
                  span #{action.label}
            elseif action.onClick
              Button(variant={action.variant ?? "outline"} size={action.size ?? "sm"} icon={action.icon} label={action.label} onClick={action.onClick} className={cn("hover:bg-input/50", action.className)})
            else
              div(className={cn(HEADER_ACTION_FALLBACK_CLASS, action.className ?? "bg-card border-border text-muted-foreground")})
                if action.icon
                  Icon(name={action.icon})
                if action.label
                  span #{action.label}
