props {title, text}: {title: string, text: string}
div(className="mt-3 bg-border/15 dark:bg-border/30 border border-border/25 dark:border-border/30 rounded-xl shadow-xs p-3 flex gap-3")
  div(className="text-orange-300 text-[12px]") ●
  div(className="text-[12px] leading-relaxed")
    div(className="font-display font-bold text-foreground tracking-tight") #{title}
    div(className="text-muted-foreground font-mono mt-1") #{text}
