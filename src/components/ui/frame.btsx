import { cn } from "@/lib/utils"

module
  export interface FrameProps {
    title?: string
    subtitle?: string
    className?: string
    children?: unknown
    extra?: unknown
    titlebar?: boolean
  }

  const FRAME_CLASS = "flex flex-col overflow-hidden rounded-xl border border-border/50"

props { title, subtitle, className, children, extra, titlebar=true }: FrameProps

div(className={cn(FRAME_CLASS, className, {'bg-card': titlebar})})
  if title
    div(className={cn("h-12 border-b border-border/50 flex items-center justify-between px-3 shrink-0", {'border-b-0': !titlebar} )})
      div(className="flex items-center gap-1")
        span(className="text-sm font-medium font-sans text-muted-foreground ml-2 capitalize") #{title}
      div #{extra}
      if subtitle
        span(className="font-mono text-muted-foreground/80 text-xs px-2") #{subtitle}
  div(className="w-full") #{children}
