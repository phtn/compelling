import { cn } from "@/lib/utils"

module
  interface FrameProps {
    title?: string;
    subtitle?: string;
    className?: string;
  }

props { title, subtitle, className }: FrameProps
div(className={cn("bg-[#0a0a0a] border border-[#1a1a1a] rounded-xs overflow-hidden flex flex-col", className)})
  if title
    div(className="h-9 bg-black border-b border-[#1a1a1a] flex items-center justify-between px-3 shrink-0")
      div(className="flex items-center gap-2")
        div(className="w-2 h-2 rounded-xs bg-[#525252]")
        div(className="w-2 h-2 rounded-xs bg-[#525252]")
        div(className="w-2 h-2 rounded-xs bg-[#525252]")
        span(className="text-[11px] font-mono tracking-wide text-[#666] ml-2") #{title}
      if subtitle
        span(className="text-[11px] font-mono text-[#525252]") #{subtitle}
  div(className="flex-1 overflow-auto")
    slot
