import { useEffect, useMemo, useRef, useState } from "octane"
import { cn } from "@/lib/utils"
import Icon from "@/lib/icons/index.btsx"
import Header from "@/components/ui/header.btsx"
import Frame from "@/components/ui/frame.btsx"
import Input from "@/components/ui/input.btsx"


module
  interface Item { id: string; title: string; category: string; height: number; likes: number; price: number; seed: number; color: string; author: string }
  const CATS = ["All", "Nature", "Architecture", "People", "Tech", "Food"] as const
  const COLORS: Record<string, string> = { Nature: "#171717", Architecture: "#262626", People: "#404040", Tech: "#525252", Food: "#737373" }
  function makeItems(n: number): Item[] {
    const out: Item[] = []
    const cats = ["Nature", "Architecture", "People", "Tech", "Food"] as const
    const titles = ["Alpine Ridge", "Neon Grid", "Harbor Light", "Desert Bloom", "Urban Canopy", "Silent Echo", "Solar Flare", "Midnight Olive", "Concrete Wave", "Velvet Dusk"]
    for (let i = 0; i < n; i++) {
      const cat = cats[i % cats.length]!
      const h = 180 + (i % 7) * 34 + Math.floor((Math.sin(i * 1.7) + 1) * 30)
      out.push({
        id: "item-" + i,
        title: titles[i % titles.length]! + " #" + i,
        category: cat,
        height: h,
        likes: 40 + (i * 13) % 500,
        price: 12 + (i % 50) * 3,
        seed: i,
        color: COLORS[cat]!,
        author: ["Alex", "Maya", "Jordan", "Riley", "Casey"][i % 5]!,
      })
    }
    return out
  }

props {}: {}

setup
  const containerRef = useRef<HTMLDivElement | null>(null)
  const [query, setQuery] = useState("")
  const [category, setCategory] = useState("All")
  const [sort, setSort] = useState("featured")
  const [columns, setColumns] = useState(3)
  const [gap, setGap] = useState(16)
  const [overscan, setOverscan] = useState(3)
  const [scrollTop, setScrollTop] = useState(0)
  const [viewportH, setViewportH] = useState(640)
  const [remeasures, setRemeasures] = useState(0)
  const allItems = useMemo(() => makeItems(10000), [])
  const filtered = useMemo(() => {
    let out = allItems
    if (category !== "All") out = out.filter((i) => i.category === category)
    if (query) {
      const q = query.toLowerCase()
      out = out.filter((i) => i.title.toLowerCase().includes(q) || i.category.toLowerCase().includes(q) || i.author.toLowerCase().includes(q))
    }
    if (sort === "likes") out = [...out].sort((a, b) => b.likes - a.likes)
    if (sort === "price-asc") out = [...out].sort((a, b) => a.price - b.price)
    if (sort === "price-desc") out = [...out].sort((a, b) => b.price - a.price)
    if (sort === "newest") out = [...out].sort((a, b) => b.seed - a.seed)
    return out
  }, [allItems, query, category, sort])
  const avgH = 280
  const rowH = avgH + gap
  const totalRows = useMemo(() => Math.ceil(filtered.length / columns), [filtered.length, columns])
  const totalHeight = totalRows * rowH
  const startRow = useMemo(() => Math.max(0, Math.floor(scrollTop / rowH) - overscan), [scrollTop, rowH, overscan])
  const endRow = useMemo(() => Math.min(totalRows, Math.ceil((scrollTop + viewportH) / rowH) + overscan), [scrollTop, viewportH, rowH, totalRows, overscan])
  const startIdx = startRow * columns
  const endIdx = Math.min(filtered.length, endRow * columns)
  const visible = useMemo(() => filtered.slice(startIdx, endIdx), [filtered, startIdx, endIdx])
  const visibleCount = visible.length
  const ratio = useMemo(() => filtered.length ? Math.round((visibleCount / filtered.length) * 1000) / 10 : 0, [visibleCount, filtered.length])
  const topOffset = startRow * rowH

  useEffect(() => {
    const el = containerRef.current
    if (!el) return
    const onScroll = () => setScrollTop(el.scrollTop)
    const onResize = () => setViewportH(el.clientHeight)
    el.addEventListener("scroll", onScroll, { passive: true })
    window.addEventListener("resize", onResize)
    onResize()
    const ro = new ResizeObserver(() => {
      setRemeasures((c) => c + 1)
    })
    ro.observe(el)
    return () => {
      el.removeEventListener("scroll", onScroll)
      window.removeEventListener("resize", onResize)
      ro.disconnect()
    }
  }, [])
  useEffect(() => {
    const el = containerRef.current
    if (el) setViewportH(el.clientHeight)
  }, [columns, gap])
  const clearFilters = () => {
    setQuery("")
    setCategory("All")
    setSort("featured")
  }

  const [showInfo, setShowInfo] = useState(false)
  const toggleInfo = () => setShowInfo(!showInfo)

  const actions = [
    {id: "clear", label: "Clear filters", onClick: clearFilters, className: ""}]

div.bg-background
  div(className="w-full px-2 sm:px-3 md:px-4 lg:px-5 xl:px-6 py-6")
    Header(title="Virtualized Masonry Grid" subtitle="GRID VIRTUALIZATION" icon='mechanics' description="10,000 items, dynamic heights, ResizeObserver remeasure. Built-in virtualize renders only the viewport + overscan — column masonry without fixed-size assumptions." isVisible={showInfo} toggleFn={toggleInfo} actions={actions})
    div.grid.grid-cols-12.gap-4
      div(className="col-span-12 lg:col-span-9")
        Frame(title={'Virtualized '+ columns + ' columns | gap ' + gap + 'px'} subtitle={visibleCount + ' rendered — est. ' + totalHeight.toLocaleString() + 'px'} )
          div(ref={containerRef} className="relative h-[640px] overflow-auto bg-background p-2")
            div(style={"column-count:" + columns + ";column-gap:" + gap + "px"})
              each item in visible key item.id
                div(className="break-inside-avoid mb-4 bg-card border border-border rounded-xs overflow-hidden hover:border-input transition group")
                  div.relative.overflow-hidden(style={"height:" + item.height + "px;background:" + item.color})
                    img(className="w-full h-full object-cover opacity-80 group-hover:opacity-90 transition duration-500 grayscale group-hover:grayscale-0" src={"https://picsum.photos/seed/" + item.seed + "/400/" + item.height} alt={item.title})
                    div(className="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent")
                    div(className="absolute top-2 left-2 px-1.5 py-1 rounded-xs text-[10px] font-mono font-medium tracking-wide text-foreground border border-primary/20" style={"background:" + item.color}) #{item.category.toUpperCase()}
                    div(className="absolute bottom-2 right-2 px-2 py-1 rounded-xs bg-background/80 backdrop-blur border border-input text-[11px] font-mono font-medium text-foreground") $#{item.price}
                  div.p-3
                    div.flex.items-start.justify-between.gap-2
                      div.flex-1.min-w-0
                        div(className="text-[13px] font-medium text-foreground leading-tight truncate") #{item.title}
                        div(className="text-[11px] font-mono text-muted-foreground") by #{item.author} · seed #{item.seed}
                      div(className="w-7 h-7 rounded-xs grid place-items-center text-foreground text-[10px] font-mono font-medium border border-primary" style={"background:" + item.color}) #{item.author.slice(0,1)}
                    div.flex.items-center.gap-2.mt-2
                      div(className="flex items-center gap-1 text-[11px] font-mono")
                        span.text-foreground ★
                        span(className="text-muted-foreground") #{item.likes}
                      div(className="ml-auto px-2 py-1 rounded-xs bg-background border border-border text-[11px] font-mono text-muted-foreground") #{item.height}px
                    div.flex.gap-1.mt-2
                      span(className="px-2 py-1 rounded-xs bg-background border border-border text-[11px] font-mono text-muted-foreground") #{Math.round(item.height/10)*10}h
                      span(className="px-2 py-1 rounded-xs bg-background border border-border text-[11px] font-mono text-muted-foreground") #{item.id}
          div(className="grid grid-cols-3 divide-x divide-border bg-background text-center text-[11px] font-mono")
            div.p-3
              div(className="font-medium text-foreground text-[13px]") #{filtered.length.toLocaleString()}
              div(className="tracking-wide text-muted-foreground") FILTERED
            div.p-3
              div(className="font-medium text-foreground text-[13px]") #{visibleCount}
              div(className="tracking-wide text-muted-foreground") IN DOM
            div.p-3
              div(className="font-medium text-foreground text-[13px]") -#{(100 - ratio).toFixed(1)}%
              div(className="tracking-wide text-muted-foreground") COST SAVED
        div(className="mt-3 bg-card border border-border rounded-xs p-4")
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") PERFORMANCE NOTES
          div(className="grid sm:grid-cols-3 gap-px bg-border border border-border rounded-xs overflow-hidden mt-3")
            div.bg-background.p-3
              div(className="font-medium text-foreground text-[12px]") ResizeObserver
              div(className="text-muted-foreground mt-1 text-[11px] font-mono") Remeasures on column/gap change. Count #{remeasures}.
            div.bg-background.p-3
              div(className="font-medium text-foreground text-[12px]") Overscan #{overscan}
              div(className="text-muted-foreground mt-1 text-[11px] font-mono") Extra rows above/below viewport to avoid blank scroll.
            div.bg-background.p-3
              div(className="font-medium text-foreground text-[12px]") 10k → #{visibleCount}
              div(className="text-muted-foreground mt-1 text-[11px] font-mono") No fixed size assumptions. Dynamic heights.
      div(className="col-span-12 lg:col-span-3 rounded-xs h-fit sticky top-[72px]")
        div
          Input(value={query} onChange={(v) => setQuery(v as string)} placeholder="Search title, category")
          div(className="text-[11px] font-mono text-right text-muted-foreground mt-1") #{filtered.length.toLocaleString()} matches
        div.mt-4
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") CATEGORY
          div.flex.flex-wrap.gap-1.mt-2
            each cat in CATS key cat
              button(onClick={() => setCategory(cat)} class={"px-2.5 py-1 rounded-xs text-[11px] font-mono font-medium border transition " + (category === cat ? "bg-primary text-primary-foreground border-primary" : "bg-background border-border text-muted-foreground hover:bg-muted hover:text-foreground")}) #{cat}
        div.mt-4.grid.grid-cols-2.gap-3
          div
            label(className="block text-[11px] font-mono tracking-wide text-muted-foreground mb-1 5") SORT
            select(className="w-full bg-background border border-input rounded-xs px-2 py-2 text-[12px] font-mono" value={sort} onChange={(e) => setSort((e.target as HTMLSelectElement).value)})
              option(value="featured") Featured
              option(value="likes") Most liked
              option(value="price-asc") Price low→high
              option(value="price-desc") Price high→low
              option(value="newest") Newest
          div
            label(className="block text-[11px] font-mono tracking-wide text-muted-foreground mb-1 5") COLUMNS — #{columns}
            input.w-full.accent-white(type="range" min="1" max="5" value={columns} onInput={(e) => setColumns(parseInt((e.target as HTMLInputElement).value, 10))})
        div.mt-3.grid.grid-cols-2.gap-3
          div
            label(className="block text-[11px] font-mono tracking-wide text-muted-foreground mb-1 5") GAP — #{gap}px
            input.w-full.accent-white(type="range" min="8" max="32" value={gap} onInput={(e) => setGap(parseInt((e.target as HTMLInputElement).value, 10))})
          div
            label(className="block text-[11px] font-mono tracking-wide text-muted-foreground mb-1 5") OVERSCAN — #{overscan}
            input.w-full.accent-white(type="range" min="0" max="8" value={overscan} onInput={(e) => setOverscan(parseInt((e.target as HTMLInputElement).value, 10))})
        div(className="rounded-xs mt-6 space-y-2 text-xs font-mono")
          div.flex.justify-between
            span(className="text-muted-foreground") Total
            span.font-medium.text-foreground #{filtered.length.toLocaleString()}
          div.flex.justify-between
            span(className="text-muted-foreground") Rendered
            span.font-medium.text-foreground #{visibleCount.toLocaleString()} (#{ratio}%)
          div.flex.justify-between
            span(className="text-muted-foreground") Saved renders
            span.font-medium.text-foreground #{(filtered.length - visibleCount).toLocaleString()}
          div(className="w-full h-1 bg-border rounded-xs overflow-hidden")
            div.h-1.bg-primary(style={"width:" + ratio + "%"})
          div.flex.justify-between
            span(className="text-muted-foreground") Remeasures
            span.text-foreground #{remeasures}
          div.flex.justify-between
            span(className="text-muted-foreground") Row height (est.)
            span.text-foreground #{rowH}px
          div.flex.justify-between
            span(className="text-muted-foreground") Viewport
            span.text-foreground #{viewportH}px · top #{Math.round(scrollTop)}px
        div(className="rounded-xs mt-6 text-xs leading-relaxed font-mono")
          div.font-medium.text-foreground Why Octane wins
            div(className="text-muted-foreground mt-1") React-Window needs fixed.
