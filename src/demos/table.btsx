import { useState } from "octane";
props {}:{}

setup
  const [value, setValue] = useState("");
  const handleInput = (v: string) => {
    setValue(v.target.value);
  };


div.bg-background
  div(className="w-full px-2 sm:px-3 md:px-4 lg:px-5 xl:px-6 py-6 space-x-4")
    label input
    input(onInput={handleInput} className="bg-input" placeholder="")
    span #{value}
