import { Activity, ErrorBoundary, Hydrate, Suspense, use } from "octane"
import { idle, initializeHydrationEventCapture, interaction, load, media, never, visible } from "octane/hydration"
import { useEffect, useMemo, useState } from "octane"
import Header from "@/components/ui/header.btsx"
import Frame from "@/components/ui/frame.btsx"

module
  interface Review { id: string; author: string; rating: number; text: string; date: string; verified: boolean }
  interface Related { id: string; title: string; price: number; image: string; rating: number }
  interface QA { q: string; a: string; helpful: number }
  const REVIEWS: Review[] = [
    { id: "r1", author: "Alex R.", rating: 5, text: "Reference-grade clarity. Dirac Live tamed my room in one pass. Atmos is holographic.", date: "2 days ago", verified: true },
    { id: "r2", author: "Maya P.", rating: 5, text: "HDAM warmth without mud. 11.4 channels actually feel discrete. Worth every dollar.", date: "1 week ago", verified: true },
    { id: "r3", author: "Jordan L.", rating: 4, text: "Setup took 30 minutes. HEOS is surprisingly solid. Would buy again.", date: "2 weeks ago", verified: false },
    { id: "r4", author: "Riley K.", rating: 5, text: "A/B tested against Denon X6800 — Marantz wins on music, ties on movies.", date: "3 weeks ago", verified: true },
  ]
  const RELATED: Related[] = [
    { id: "rel1", title: "Denon AVC-X6800H", price: 3299, image: "https://picsum.photos/seed/denon6800/400/300", rating: 4.9 },
    { id: "rel2", title: "Yamaha RX-A8A", price: 2799, image: "https://picsum.photos/seed/yamaha8a/400/300", rating: 4.8 },
    { id: "rel3", title: "Anthem MRX 1140", price: 3999, image: "https://picsum.photos/seed/anthem/400/300", rating: 4.9 },
  ]
  const QAS: QA[] = [
    { q: "Does this support 8K/120Hz passthrough?", a: "Yes — 7x HDMI 2.1 (40Gbps) with 8K60 and 4K120, plus eARC. VRR/ALLM pass through untouched.", helpful: 42 },
    { q: "Can I use Dirac Live without extra hardware?", a: "Included mic + app. Full-room correction in ~10 min. Optional Dirac Live Bass Control upgrade.", helpful: 31 },
    { q: "How does it compare to separates?", a: "For < 300W peaks, this matches separates. Above that, pair front L/R pre-outs to an external amp.", helpful: 18 },
  ]
  function fetchReviews(): Promise<Review[]> {
    return new Promise((res) => setTimeout(() => res(REVIEWS), 1800))
  }
  function fetchRelated(): Promise<Related[]> {
    return new Promise((res) => setTimeout(() => res(RELATED), 1400))
  }
  function fetchQA(): Promise<QA[]> {
    return new Promise((res) => setTimeout(() => res(QAS), 1100))
  }

component ReviewList
  props { data }: { data: Promise<Review[]> }
  setup const reviews = use(data)
  div.space-y-3
    each r in reviews key r.id
      div(className="bg-background border border-border rounded-xs p-4")
        div.flex.items-center.justify-between
          div.flex.items-center.gap-2
            div(className="w-7 h-7 rounded-xs bg-primary text-primary-foreground grid place-items-center font-mono font-medium text-[11px]") #{r.author.slice(0,1)}
            div
              div(className="text-[13px] font-medium text-foreground") #{r.author} #{r.verified ? "· ✓ Verified" : ""}
              div(className="text-[11px] font-mono text-muted-foreground") #{r.date}
          div(className="flex text-foreground text-[11px]")
            each _ in Array(r.rating).fill(0) key _
              span ★
        p(className="text-[13px] text-muted-foreground mt-2 leading-relaxed font-mono") #{r.text}

component RelatedGrid
  props { data }: { data: Promise<Related[]> }
  setup const items = use(data)
  div(className="grid sm:grid-cols-3 gap-2")
    each rel in items key rel.id
      div(className="bg-background border border-border rounded-xs overflow-hidden")
        img.w-full.h-28.object-cover.grayscale.opacity-80(src={rel.image} alt={rel.title})
        div.p-3
          div(className="text-[13px] font-medium text-foreground truncate") #{rel.title}
          div.flex.items-center.justify-between.mt-1
            span(className="text-[13px] font-mono font-medium text-foreground") $#{rel.price.toLocaleString()}
            span(className="text-[11px] font-mono text-muted-foreground") ★ #{rel.rating}

component QAList
  props { data }: { data: Promise<QA[]> }
  setup const qas = use(data)
  div.space-y-2
    each qa in qas key qa.q
      details(className="bg-background border border-border rounded-xs p-4 group")
        summary.cursor-pointer.list-none.flex.items-center.justify-between
          span(className="text-[13px] font-medium text-foreground") #{qa.q}
          span(className="text-muted-foreground group-open:rotate-90 transition font-mono text-[11px]") →
        p(className="text-[13px] text-muted-foreground mt-2 leading-relaxed font-mono") #{qa.a}
        div(className="text-[11px] font-mono text-muted-foreground mt-2") #{qa.helpful} found helpful · Helpful?

props {}: {}

setup
  const [hydrated, setHydrated] = useState({ load: false, idle: false, visible: false, interaction: false, media: false })
  const [showDetail, setShowDetail] = useState(false)
  const [cartCount, setCartCount] = useState(0)
  const [activeQA, setActiveQA] = useState(0)
  const [reviewsPromise] = useState(() => fetchReviews())
  const [relatedPromise] = useState(() => fetchRelated())
  const [qaPromise] = useState(() => fetchQA())
  const [serverTime] = useState(() => Date.now())
  const [showToast, setShowToast] = useState(false)
  const [toastMsg, setToastMsg] = useState("")
  const elapsed = useMemo(() => Math.round((Date.now() - serverTime) / 100) / 10, [hydrated])
  useEffect(() => {
    initializeHydrationEventCapture(document)
    const t1 = window.setTimeout(() => setHydrated((h) => ({ ...h, load: true })), 100)
    return () => window.clearTimeout(t1)
  }, [])
  const addToCart = () => {
    setCartCount((c) => c + 1)
    setToastMsg("Added to cart · " + (cartCount + 1) + " items")
    setShowToast(true)
    window.setTimeout(() => setShowToast(false), 2400)
  }
  const [showInfo, setShowInfo] = useState(false)
  const toggleInfo = () => setShowInfo(!showInfo)
  const forceHydrateAll = () => setHydrated({ load: true, idle: true, visible: true, interaction: true, media: true })

  const actions = [
    {id: "cart", label: "Cart (" + cartCount + ")", onClick: addToCart, className: ""},
    {id: "force", label: "Force hydrate all", onClick: forceHydrateAll, className: ""},
    {id: "elapsed", label: elapsed + "s since shell", className: ""}]

div.bg-background
  div(className="w-full px-2 sm:px-3 md:px-4 lg:px-5 xl:px-6 py-6")
    Header(title="Isomorphic Shell with Progressive Hydration" subtitle="PROGRESSIVE HYDRATION" icon='mechanics' description="Seamless SSR without hydration mismatches. Same component server + client. suspend/resume, hydration when idle/visible/interaction." isVisible={showInfo} toggleFn={toggleInfo} actions={actions})
    if showToast
      div(className="fixed bottom-6 right-6 z-50 bg-primary text-primary-foreground px-4 py-3 rounded-xs shadow-2xl border border-border flex items-center gap-2")
        div(className="w-6 h-6 rounded-xs bg-background text-foreground grid place-items-center text-[11px] font-mono") ✓
        span(className="font-medium text-[13px]") #{toastMsg}

    div.grid.grid-cols-12.gap-4
      div(className="col-span-12 lg:col-span-8 flex flex-col gap-4")
        Hydrate(when={load()} split={false} onHydrated={() => setHydrated((h) => ({ ...h, load: true }))})
          Frame(title="Storefront · load() — immediate" subtitle={hydrated.load ? "hydrated \u2713 \u00b7 " + elapsed + "s" : "hydrating\u2026 \u00b7 " + elapsed + "s"})
            div(className="p-6 sm:p-8 flex flex-col lg:flex-row gap-6")
              div.flex-1
                div(className="inline-flex items-center gap-2 text-[11px] font-mono tracking-wide text-muted-foreground")
                  span.px-1.5.py-1.rounded-xs.bg-primary.text-primary-foreground.font-medium FLAGSHIP
                  span 11.4CH · 140W · HDMI 2.1
                h2(className="text-[24px] font-semibold tracking-[-0.02em] leading-none mt-3 text-foreground") Marantz Cinema 30
                p(className="text-muted-foreground text-[13px] leading-relaxed mt-2 font-mono") The reference powerhouse with HDAM, Dirac Live, 8K passthrough. Server-rendered shell — same code, no mismatch.
                div.flex.flex-wrap.gap-1.5.mt-4
                  each f in ["Dolby Atmos", "IMAX Enhanced", "Dirac Live", "HEOS"] key f
                    span(className="px-2 py-1 rounded-xs bg-background border border-border text-[11px] font-mono text-muted-foreground") #{f}
                div.flex.items-end.gap-4.mt-5
                  div
                    div(className="text-[11px] font-mono line-through text-muted-foreground") $4,999
                    div(className="text-[20px] font-semibold tracking-tight text-foreground") $4,499
                  button(className="flex-1 sm:flex-none bg-accent-1 text-foreground hover:bg-primary font-medium px-5 py-2.5 rounded-xs text-[13px] transition flex items-center justify-center gap-2 border border-accent-1" onClick={addToCart})
                    span Add to Cart
                    span.font-mono →
                  button(className="px-4 py-2.5 rounded-xs border border-input text-muted-foreground hover:bg-muted hover:text-foreground transition font-medium text-[13px]" onClick={() => setShowDetail(!showDetail)}) #{showDetail ? "Hide" : "Details"}
                div(className="flex items-center gap-3 text-[11px] font-mono text-muted-foreground mt-3")
                  span.flex.items-center.gap-1
                    span.w-1.h-1.rounded-xs.bg-primary
                    span In stock · Ships today
                  span(className="text-muted-foreground") ·
                  span Free 2-day delivery
              div(className="w-full lg:w-72 h-56 lg:h-64 bg-background rounded-xs overflow-hidden relative border border-border")
                img.w-full.h-full.object-cover.opacity-80.grayscale(src="https://picsum.photos/seed/marantz30/600/400" alt="Marantz")
                div.absolute.inset-0.bg-gradient-to-t.from-black.via-transparent.to-transparent
                div(className="absolute bottom-3 left-3 right-3 bg-background/80 backdrop-blur border border-input rounded-xs p-3 flex items-center justify-between")
                  div
                    div(className="text-[11px] font-mono tracking-wide text-muted-foreground") TODAY'S DEAL
                    div(className="text-[13px] font-medium text-foreground") Save $500 — ends midnight
                  div(className="text-[11px] font-mono text-foreground") 04:21:33
            if showDetail
              div(className="px-6 pb-6 grid sm:grid-cols-3 gap-px bg-border border-t border-border rounded-xs overflow-hidden mt-4")
                div.bg-background.p-3
                  div(className="font-medium text-foreground text-[12px]") Power
                  div(className="text-muted-foreground text-[11px] font-mono") 140W × 11.4, HDAM discrete
                div.bg-background.p-3
                  div(className="font-medium text-foreground text-[12px]") HDMI
                  div(className="text-muted-foreground text-[11px] font-mono") 7× 8K, eARC, VRR passthrough
                div.bg-background.p-3
                  div(className="font-medium text-foreground text-[12px]") Room EQ
                  div(className="text-muted-foreground text-[11px] font-mono") Dirac Live included

        Hydrate(when={idle({ timeout: 1500 })} split={false} onHydrated={() => setHydrated((h) => ({ ...h, idle: true }))})
          Frame(title="Reviews · idle({ timeout: 1500 })" subtitle={hydrated.idle ? "hydrated \u2713" : "waiting for idle\u2026"})
            div.p-6
              div.flex.items-center.justify-between
                div
                  h3(className="text-[14px] font-medium tracking-[-0.01em] text-foreground") Reviews
                  p(className="text-[11px] font-mono text-muted-foreground") Suspends server render, resumes on client
                div(className="flex items-center gap-1 text-foreground text-[11px]") ★★★★★
                  span(className="text-[11px] font-mono text-muted-foreground ml-1") 4.9 (189)
              ErrorBoundary(fallback="Reviews failed to load.")
                Suspense(fallback="Loading reviews… (suspended 1.8s)")
                  ReviewList(data={reviewsPromise})
              div(className="mt-3 text-[11px] font-mono text-muted-foreground") Hydrate when idle → server sends seeded HTML, client hydrates without blocking main thread.

        Hydrate(when={visible({ rootMargin: "200px" })} split={false} onHydrated={() => setHydrated((h) => ({ ...h, visible: true }))})
          Frame(title="Related · visible({ rootMargin: \"200px\" })" subtitle={hydrated.visible ? "hydrated \u2713" : "waiting for visible\u2026"})
            div.p-6
              h3(className="text-[14px] font-medium tracking-[-0.01em] text-foreground") You may also like
              p(className="text-[11px] font-mono text-muted-foreground mt-1") Hydrates only when scrolled into view — saves JS until needed.
              ErrorBoundary(fallback="Related failed.")
                Suspense(fallback="Loading related…")
                  RelatedGrid(data={relatedPromise})
              div(className="mt-3 text-[11px] font-mono text-muted-foreground") Scrolled into viewport → hydration gate resolves.

        Hydrate(when={interaction({ events: ["click", "focusin"] })} split={false} onHydrated={() => setHydrated((h) => ({ ...h, interaction: true }))})
          Frame(title="Q\u0026A · interaction([\"click\",\"focusin\"])" subtitle={hydrated.interaction ? "hydrated \u2713" : "waiting for click\u2026"})
            div.p-6
              h3(className="text-[14px] font-medium tracking-[-0.01em] text-foreground") Q&A
              p(className="text-[11px] font-mono text-muted-foreground") Click to hydrate — captures early events before JS loads.
              ErrorBoundary(fallback="Q&A failed.")
                Suspense(fallback="Loading...")
                  QAList(data={qaPromise})
              div.mt-3.flex.gap-1.5
                each idx in [0,1,2] key idx
                  button(onClick={() => setActiveQA(idx)} class={"px-3 py-1 rounded-xs text-[11px] font-mono font-medium border " + (activeQA === idx ? "bg-primary text-primary-foreground border-primary" : "bg-background border-border text-muted-foreground hover:text-foreground")}) Q#{idx+1}
              div(className="mt-3 p-3 bg-background border border-border rounded-xs")
                div(className="text-[13px] font-medium text-foreground") #{["Does this support 8K/120Hz passthrough?", "Can I use Dirac Live without extra hardware?", "How does it compare to separates?"][activeQA]}
                div(className="text-[13px] text-muted-foreground mt-1 leading-relaxed font-mono") #{["Yes — 7x HDMI 2.1 (40Gbps) with 8K60 and 4K120, plus eARC. VRR/ALLM pass through untouched.", "Included mic + app. Full-room correction in ~10 min. Optional Dirac Live Bass Control upgrade.", "For < 300W peaks, this matches separates. Above that, pair front L/R pre-outs to an external amp."][activeQA]}
                div(className="text-[11px] font-mono text-muted-foreground mt-2") Active Q#{activeQA + 1} — click buttons to switch
              div(className="mt-2 text-[11px] font-mono text-muted-foreground") Event capture via initializeHydrationEventCapture(document) — no lost clicks.

      div(className="col-span-12 lg:col-span-4 flex flex-col gap-4 sticky top-[72px] h-fit")
        Hydrate(when={media("(min-width: 1024px)")} split={false} onHydrated={() => setHydrated((h) => ({ ...h, media: true }))})
          div(className="bg-card border border-border rounded-xs p-4")
            div.flex.items-center.justify-between
              div(className="text-[11px] font-mono tracking-wide text-muted-foreground") SIDEBAR — media("(min-width: 1024px)")
              span(class={"px-2 py-1 rounded-xs text-[11px] font-mono font-medium " + (hydrated.media ? "bg-primary text-primary-foreground" : "bg-border text-muted-foreground")}) #{hydrated.media ? "hydrated" : "not hydrated"}
            div(className="mt-3 space-y-2 text-[11px] font-mono")
              div(className="bg-background border border-border rounded-xs p-3 flex items-center justify-between")
                span(className="text-muted-foreground") Specs hydration
                span.text-foreground #{hydrated.media ? "visible" : "hidden on mobile"}
              div(className="bg-background border border-border rounded-xs p-3")
                div.font-medium.text-foreground Technical specs
                div(className="text-muted-foreground mt-1") Only hydrates on ≥1024px. Saves JS on mobile.
                table(className="w-full mt-2 text-[11px]")
                  tr(className="border-b border-border")
                    td(className="py-1 text-muted-foreground") Power
                    td.py-1.text-foreground.text-right 140W/ch
                  tr(className="border-b border-border")
                    td(className="py-1 text-muted-foreground") Channels
                    td.py-1.text-foreground.text-right 11.4
                  tr
                    td(className="py-1 text-muted-foreground") HDMI
                    td.py-1.text-foreground.text-right 7× 8K
            div(className="text-[11px] font-mono text-muted-foreground mt-2") media query gate.

        div(className="bg-card border border-border rounded-xs p-4")
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") HYDRATION TIMELINE
          div.mt-3.space-y-2
            div.flex.items-center.gap-3
              div.w-1.5.h-1.5.rounded-xs(class={hydrated.load ? "bg-primary" : "bg-muted"})
              div(className="flex-1 h-1 bg-border rounded-xs overflow-hidden")
                div.h-1.bg-primary.transition-all(style={"width:" + (hydrated.load ? "100%" : "20%")})
              span(className="text-[11px] font-mono text-foreground") load
            div.flex.items-center.gap-3
              div.w-1.5.h-1.5.rounded-xs(class={hydrated.idle ? "bg-primary" : "bg-muted-foreground animate-pulse"})
              div(className="flex-1 h-1 bg-border rounded-xs overflow-hidden")
                div.h-1.bg-primary.transition-all(style={"width:" + (hydrated.idle ? "100%" : "15%")})
              span(className="text-[11px] font-mono text-foreground") idle 1.5s
            div.flex.items-center.gap-3
              div.w-1.5.h-1.5.rounded-xs(class={hydrated.visible ? "bg-primary" : "bg-muted-foreground animate-pulse"})
              div(className="flex-1 h-1 bg-border rounded-xs overflow-hidden")
                div.h-1.bg-primary.transition-all(style={"width:" + (hydrated.visible ? "100%" : "10%")})
              span(className="text-[11px] font-mono text-foreground") visible
            div.flex.items-center.gap-3
              div.w-1.5.h-1.5.rounded-xs(class={hydrated.interaction ? "bg-primary" : "bg-muted-foreground animate-pulse"})
              div(className="flex-1 h-1 bg-border rounded-xs overflow-hidden")
                div.h-1.bg-primary.transition-all(style={"width:" + (hydrated.interaction ? "100%" : "5%")})
              span(className="text-[11px] font-mono text-foreground") interaction
            div.flex.items-center.gap-3
              div.w-1.5.h-1.5.rounded-xs(class={hydrated.media ? "bg-primary" : "bg-muted"})
              div(className="flex-1 h-1 bg-border rounded-xs overflow-hidden")
                div.h-1.bg-primary.transition-all(style={"width:" + (hydrated.media ? "100%" : "30%")})
              span(className="text-[11px] font-mono text-foreground") media
          div(className="mt-3 text-[11px] font-mono text-muted-foreground leading-relaxed") Scroll to trigger visible, idle fires after main thread idle, click Q&A to trigger interaction. All gates use the same component code.

        div(className="bg-card border border-border rounded-xs p-4")
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") CODE — UNIVERSAL
          pre(className="bg-background border border-border rounded-xs p-3 text-[11px] font-mono leading-relaxed overflow-x-auto mt-2 text-muted-foreground")
            code const reviews = await suspend(fetchReviews)
          div(className="text-[11px] font-mono text-muted-foreground mt-2") In Octane, <span class="text-foreground">Hydrate(when={"{"}idle(){"}"})</span> + <span class="text-foreground">Suspense</span> + <span class="text-foreground">use(promise)</span> replace Next.js <span class="font-mono">getServerProps</span> boundaries.

        Hydrate(when={never()} split={false})
          div(className="bg-card border border-border rounded-xs p-4 opacity-60")
            div(className="text-[11px] font-mono tracking-wide text-muted-foreground") NEVER — static
            div(className="text-[13px] text-muted-foreground mt-2 font-mono") Footer is static, never hydrates. Zero JS shipped.
            div(className="mt-2 text-[11px] font-mono text-muted-foreground") Hydrate(when={"{"}never(){"}"})

        div(className="bg-background border border-border rounded-xs p-4")
          div(className="text-[11px] font-mono tracking-wide text-foreground") WHY IT WINS
          ul(className="list-disc list-inside text-[12px] font-mono text-muted-foreground mt-2 space-y-1 leading-relaxed")
            li Next.js requires <span class="text-foreground">getServerProps</span> per route — framework boundary.
            li Octane's <span class="text-foreground">suspend/resume</span> is universal: same component suspends server, resumes client.
            li Partial hydration via <span class="text-foreground">Hydrate</span> strategies, not whole-page.

    div(className="w-full px-6")
      div(className="bg-card border border-border rounded-xs p-6 mt-4")
        div(className="flex flex-wrap items-center gap-2 text-[11px] font-mono tracking-wide text-muted-foreground")
          span(className="px-2 py-1 rounded-xs bg-background border border-border") ACTIVITY & ERROR
          span Demo of Octane's other shell primitives
        div(className="grid sm:grid-cols-3 gap-2 mt-3")
          Activity(mode="visible")
            div(className="bg-background border border-border rounded-xs p-3 text-[11px] font-mono")
              div.font-medium.text-foreground Activity visible
              div(className="text-muted-foreground mt-1") Hydrated and visible — fully interactive.
          Activity(mode="hidden")
            div(className="bg-background border border-border rounded-xs p-3 text-[11px] font-mono")
              div.font-medium.text-foreground Activity hidden
              div(className="text-muted-foreground mt-1") Hidden but preserved — not unmounted.
          ErrorBoundary(fallback="Error captured")
            div(className="bg-background border border-border rounded-xs p-3 text-[11px] font-mono")
              div.font-medium.text-foreground Error captured
              div(className="text-muted-foreground mt-1") Fallback rendered without crashing shell.
          Suspense(fallback="Loading...")
            div(className="bg-background border border-border rounded-xs p-3 text-[11px] font-mono")
              div.font-medium.text-foreground Suspense works
              div(className="text-muted-foreground mt-1") Content suspended correctly.
