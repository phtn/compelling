import { useEffect, useMemo, useState } from "octane"
import Header from "@/components/ui/header.btsx"
import Frame from "@/components/ui/frame.btsx"
import Callout from "@/components/ui/callout.btsx"

module
  interface HistoryEntry { value: string; ts: number; branch: number }

props {}: {}

setup
  const [content, setContent] = useState("Hello Octane — built-in temporal reactivity")
  const [history, setHistory] = useState<HistoryEntry[]>([{ value: "Hello Octane — built-in temporal reactivity", ts: Date.now(), branch: 0 }])
  const [pos, setPos] = useState(0)
  const [branches, setBranches] = useState(1)
  const [compress, setCompress] = useState(true)
  const [maxBranches] = useState(50)
  const canUndo = useMemo(() => pos > 0, [pos])
  const canRedo = useMemo(() => pos < history.length - 1, [pos, history])
  const branchDepth = useMemo(() => history[pos]?.branch ?? 0, [history, pos])
  const undo = () => {
    if (!canUndo) return
    const next = pos - 1
    setPos(next)
    setContent(history[next]!.value)
  }
  const redo = () => {
    if (!canRedo) return
    const next = pos + 1
    setPos(next)
    setContent(history[next]!.value)
  }
  const fork = () => {
    const b = branches
    setBranches((n) => n + 1)
    const entry: HistoryEntry = { value: content + " ⟋ fork " + b, ts: Date.now(), branch: b }
    const nextHist = [...history.slice(0, pos + 1), entry]
    setHistory(nextHist.slice(-maxBranches))
    setPos(nextHist.length - 1)
    setContent(entry.value)
  }
  const scrubTo = (v: number) => {
    const idx = Math.max(0, Math.min(history.length - 1, Math.round(v)))
    setPos(idx)
    setContent(history[idx]!.value)
  }
  const handleInput = (e: Event) => {
    const val = (e.target as HTMLTextAreaElement).value
    setContent(val)
    // compress rapid keystrokes
    const last = history[pos]
    const now = Date.now()
    const isRapid = compress && last && now - last.ts < 400 && history.length > 1
    const entry: HistoryEntry = { value: val, ts: now, branch: last?.branch ?? 0 }
    if (isRapid && pos === history.length - 1) {
      const next = [...history]
      next[pos] = entry
      setHistory(next)
    } else {
      const nextHist = [...history.slice(0, pos + 1), entry]
      const trimmed = nextHist.slice(-maxBranches)
      setHistory(trimmed)
      setPos(trimmed.length - 1)
    }
  }
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "z") {
        e.preventDefault()
        if (e.shiftKey) redo()
        else undo()
      }
    }
    window.addEventListener("keydown", onKey)
    return () => window.removeEventListener("keydown", onKey)
  }, [pos, history])
  const [showInfo, setShowInfo] = useState(false)
  const toggleInfo = () => setShowInfo(!showInfo)

  const info = {
    title: "Why Octane wins",
    text: "Redux needs DevTools + manual replay. Octane treats time as dimension \u2014 timeline(signal) gives structural-shared snapshots, fork() branches instantly.",
  }

div.bg-background
  div(className="w-full px-2 sm:px-3 md:px-4 lg:px-5 xl:px-6 py-6")
    Header(title="Time-Travel" subtitle="TEMPORAL REACTIVITY" icon='mechanics' description="Immutable snapshots, bidirectional travel, branching — no Redux DevTools. timeline(content, {compress:true}) gives undo/redo/fork/scrub with structural sharing." isVisible={showInfo} toggleFn={toggleInfo} actions={[{id: "compress", label: compress ? "Compress on" : "Compress off", onClick: () => setCompress(!compress), className: "" + (compress ? "bg-input/10" : "")}, {id: "fork", label: "Fork Branch", onClick: fork, className: ""}]})

    div(className="grid grid-cols-12 gap-4")
      div(className="col-span-12 lg:col-span-8 flex flex-col gap-4")
        Frame(title={"Timeline \u00b7 " + history.length + " snapshots"} subtitle={"pos " + pos + " \u00b7 branch " + branchDepth + " \u00b7 " + branches + " branches \u00b7 " + (compress ? "compress on" : "compress off")})
          div(className="p-4")
            textarea(className="w-full min-h-[140px] bg-background border border-input rounded-xs p-3 text-[13px] font-mono text-foreground placeholder:text-muted-foreground focus:outline-none focus:border-accent-1" value={content} placeholder="Type to create history..." onInput={handleInput})
            div(className="mt-3 flex items-center gap-3")
              input(className="flex-1 accent-white" type="range" min="0" max={Math.max(0, history.length - 1)} value={pos} onInput={(e) => scrubTo(parseInt((e.target as HTMLInputElement).value, 10))})
              span(className="text-[11px] font-mono text-muted-foreground") #{pos} / #{history.length - 1}
            div(className="mt-2 flex rounded-xl border border-border overflow-hidden w-fit")
              button(className="px-3 py-1.5 text-foreground text-[11px] font-mono" onClick={undo} disabled={!canUndo}) Undo
              button(className="px-3 py-1.5 bg-muted text-muted-foreground text-[11px] font-mono hover:text-foreground" onClick={redo} disabled={!canRedo}) Redo
              button(className="px-3 py-1.5 bg-card text-muted-foreground text-[11px] font-mono" onClick={() => { setHistory([{ value: "Hello Octane — built-in temporal reactivity", ts: Date.now(), branch: 0 }]); setPos(0); setContent("Hello Octane — built-in temporal reactivity") }}) Reset
            p(className="text-[11px] font-mono text-muted-foreground mt-2") ⌘ Z | ⇧ ⌘ Z to undo/redo. Fork creates branch #{branches}. Compress dedupes &lt;400ms.
        div(className="bg-card border border-border rounded-xl p-4")
          div(className="text-[11px] h-24 font-mono tracking-wide text-muted-foreground") HISTORY — #{history.length} snapshots (max #{maxBranches})
          div(className="mt-3 grid grid-cols-1 gap-1.5 max-h-[220px] overflow-auto pr-1")
            each h, i in history.slice().reverse() key i
              div(className={"flex items-center gap-2 p-2 rounded-xl border text-[11px] font-mono " + (history.length - 1 - i === pos ? "bg-primary text-primary-foreground border-primary" : "bg-background border-border text-muted-foreground hover:border-input") } onClick={() => scrubTo(history.length - 1 - i)})
                span(className="w-6 h-6 rounded-xs grid place-items-center text-[10px]") #{history.length - 1 - i}
                span(className="flex-1 truncate") #{h.value.slice(0, 64)}#{h.value.length > 64 ? "…" : ""}
                span(className="text-[10px] px-1.5 py-0.5") b#{h.branch}
        Callout(title={info.title} text={info.text})
      div(className="col-span-12 lg:col-span-4 flex flex-col gap-4")
        div(className="bg-card border border-border rounded-xs p-4")
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") METRICS
          div(className="grid grid-cols-3 gap-px bg-border border border-border rounded-xs overflow-hidden mt-3")
            div(className="bg-background p-3 text-center")
              div(className="text-[16px] font-medium text-foreground") #{history.length}
              div(className="text-[11px] font-mono text-muted-foreground") SNAPSHOTS
            div(className="bg-background p-3 text-center")
              div(className="text-[16px] font-medium text-accent-1") #{pos}
              div(className="text-[11px] font-mono text-muted-foreground") POSITION
            div(className="bg-background p-3 text-center")
              div(className="text-[16px] font-medium text-accent-2") #{branches}
              div(className="text-[11px] font-mono text-muted-foreground") BRANCHES
          div(className="mt-3 space-y-1.5 text-[11px] font-mono")
            div(className="flex justify-between")
              span(className="text-muted-foreground") canUndo
              span(className={canUndo ? "text-foreground" : "text-muted-foreground"}) #{canUndo ? "true" : "false"}
            div(className="flex justify-between")
              span(className="text-muted-foreground") canRedo
              span(className={canRedo ? "text-foreground" : "text-muted-foreground"}) #{canRedo ? "true" : "false"}
            div(className="flex justify-between")
              span(className="text-muted-foreground") compress
              span(className="text-foreground") #{compress ? "on" : "off"}
        div(className="bg-card border border-border rounded-xs p-4")
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") CODE SHAPE
          pre(className="bg-background border border-border rounded-xs p-3 text-[11px] font-mono leading-relaxed overflow-x-auto mt-2 text-muted-foreground whitespace-pre-wrap break-words")
            code const history = timeline(content, {"{ compress:true }"})&#10;history.undo() // ← branchDepth&#10;history.scrubTo(4)
          div(className="text-[11px] font-mono text-muted-foreground mt-2") No store, no actions — signal *is* history.
        div(className="bg-background border border-border rounded-xs p-4")
          div(className="text-[11px] font-mono tracking-wide text-foreground") TIP
          ul(className="list-disc list-inside text-[12px] font-mono text-muted-foreground mt-2 space-y-1")
            li Type in textarea → new snapshot
            li Drag slider to scrub time
            li `Fork` duplicates branch #{branches} → edit diverges
            li `⌘Z` / `⇧⌘Z` works globally
