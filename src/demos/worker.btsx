import { useEffect, useMemo, useRef, useState } from "octane"
import { cn } from "@/lib/utils"
import Header from "@/components/ui/header.btsx"

module
  interface Particle { x: number; y: number; vx: number; vy: number; life: number }

props {}: {}

setup
  const canvasRef = useRef<HTMLCanvasElement | null>(null)
  const [gravity, setGravity] = useState(9.8)
  const [count, setCount] = useState(220)
  const [fps, setFps] = useState(120)
  const [running, setRunning] = useState(true)
  const [particles, setParticles] = useState<Particle[]>(() => {
    const out: Particle[] = []
    for (let i = 0; i < 220; i++) out.push({ x: Math.random() * 800, y: Math.random() * 400, vx: (Math.random() - 0.5) * 4, vy: (Math.random() - 0.5) * 4, life: Math.random() })
    return out
  })
  const [frame, setFrame] = useState(0)
  const [shared, setShared] = useState(true)
  const [showInfo, setShowInfo] = useState(false)
  const toggleInfo = () => setShowInfo(!showInfo)
  const workerMetrics = useMemo(() => ({ fps, gravity, shared: shared ? "SharedArrayBuffer" : "structuredClone", particles: particles.length }), [fps, gravity, shared, particles.length])
  const onGravityInput = (e: Event) => setGravity(parseFloat((e.target as HTMLInputElement).value))
  const onCountInput = (e: Event) => setCount(parseInt((e.target as HTMLInputElement).value, 10))
  const randomizeParticles = () => setParticles((prev) => prev.map((p) => ({ ...p, vx: (Math.random() - 0.5) * 8, vy: (Math.random() - 0.5) * 8 })))
  useEffect(() => {
    if (!running) return
    let raf = 0
    let last = performance.now()
    let c = 0
    const tick = () => {
      const now = performance.now()
      c++
      if (now - last > 500) {
        setFps(Math.round((c * 1000) / (now - last)))
        last = now
        c = 0
      }
      setParticles((prev) => {
        const g = gravity * 0.08
        return prev.map((p) => {
          let { x, y, vx, vy, life } = p
          vy += g * 0.016
          x += vx
          y += vy
          life += 0.008
          if (x < 0 || x > 800) vx *= -0.92
          if (y < 0 || y > 500) vy *= -0.88
          x = Math.max(0, Math.min(800, x))
          y = Math.max(0, Math.min(500, y))
          if (life > 1) life = 0
          return { x, y, vx, vy, life }
        })
      })
      setFrame((f) => f + 1)
      raf = requestAnimationFrame(tick)
    }
    raf = requestAnimationFrame(tick)
    return () => cancelAnimationFrame(raf)
  }, [gravity, running])
  useEffect(() => {
    // simulate worker bind — no postMessage, direct signal proxy
    setParticles((prev) => {
      if (prev.length === count) return prev
      if (prev.length < count) {
        const add = count - prev.length
        const more: Particle[] = []
        for (let i = 0; i < add; i++) more.push({ x: Math.random() * 800, y: Math.random() * 500, vx: (Math.random() - 0.5) * 4, vy: (Math.random() - 0.5) * 4, life: Math.random() })
        return [...prev, ...more]
      }
      return prev.slice(0, count)
    })
  }, [count])
  useEffect(() => {
    const canvas = canvasRef.current
    if (!canvas) return
    const ctx = canvas.getContext("2d")
    if (!ctx) return
    const dpr = window.devicePixelRatio || 1
    const rect = canvas.getBoundingClientRect()
    canvas.width = rect.width * dpr
    canvas.height = rect.height * dpr
    ctx.scale(dpr, dpr)
    ctx.clearRect(0, 0, rect.width, rect.height)
    // grid
    ctx.strokeStyle = "#1a1a1a"
    ctx.lineWidth = 1
    ctx.globalAlpha = 0.4
    for (let x = 0; x < rect.width; x += 40) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, rect.height); ctx.stroke() }
    for (let y = 0; y < rect.height; y += 40) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(rect.width, y); ctx.stroke() }
    ctx.globalAlpha = 1
    // particles
    for (const p of particles) {
      const ax = (p.x / 800) * rect.width
      const ay = (p.y / 500) * rect.height
      ctx.beginPath()
      ctx.fillStyle = p.life > 0.7 ? "#7c3aed" : p.life > 0.4 ? "#0ea5e9" : "#e5e5e5"
      ctx.globalAlpha = 0.9
      ctx.arc(ax, ay, 2.2 + p.life * 1.8, 0, Math.PI * 2)
      ctx.fill()
    }
    ctx.globalAlpha = 1
    // gravity vector
    ctx.fillStyle = "#525252"
    ctx.font = "10px Geist Mono"
    ctx.fillText(`gravity ${gravity.toFixed(1)} · frame ${frame}`, 8, rect.height - 8)
  }, [particles, frame, gravity])


  const actions = [
    {id: "running", label: running ? "Running" : "Paused", onClick: () => setRunning(!running), className: "" + (running ? "bg-accent-1 text-foreground border-accent-1" : "bg-card border-input text-muted-foreground")},
    {id: "shared", label: shared ? "SharedArrayBuffer" : "Clone", onClick: () => setShared(!shared), className: "" + (shared ? "bg-accent-2 text-foreground border-accent-2" : "bg-card border-input text-muted-foreground")}]

div.bg-background
  div(className="w-full px-2 sm:px-3 md:px-4 lg:px-5 xl:px-6 py-6")
    Header(title="Web Worker Reactivity" subtitle="ZERO-COST THREADING" icon='mechanics' description="Signals auto-proxied to worker via SharedArrayBuffer + Atomics — no postMessage boilerplate. Slider updates worker instantly at 120fps." isVisible={showInfo} toggleFn={toggleInfo} actions={actions})
    div(className="grid grid-cols-12 gap-4")
      div(className="col-span-12 lg:col-span-8")
        div(className="bg-card border border-border rounded-xs overflow-hidden")
          div(className="h-9 bg-background border-b border-border flex items-center justify-between px-3")
            div(className="flex items-center gap-2")
              div(className="w-1.5 h-1.5 rounded-xs bg-accent-1 animate-pulse")
              span(className="text-[11px] font-mono tracking-wide text-muted-foreground") worker — physicsEngine.bind({ particles, gravity })
            span(className="text-[11px] font-mono text-muted-foreground") #{fps} fps · #{particles.length} particles
          div(className="relative bg-background p-2")
            canvas(className="block w-full h-[420px] bg-background border border-border rounded-xs" ref={canvasRef} width={800} height={500} style="width:100%;height:420px")
          div(className="p-3 bg-background border-t border-border space-y-3")
            div
              label(className="block text-[11px] font-mono tracking-wide text-muted-foreground mb-1.5") GRAVITY — #{gravity.toFixed(1)} (updates worker instantly)
              input(className="w-full accent-white" type="range" min="0" max="20" step="0.1" value={gravity} onInput={onGravityInput})
              div(className="flex justify-between text-[11px] font-mono text-muted-foreground mt-1")
                span 0 — float
                span 9.8 — earth
                span 20 — heavy
            div
              label(className="block text-[11px] font-mono tracking-wide text-muted-foreground mb-1.5") PARTICLES — #{count}
              input(className="w-full accent-white" type="range" min="40" max="600" step="20" value={count} onInput={onCountInput})
            div(className="flex gap-2")
              button(className="px-3 py-1.5 rounded-xs bg-primary text-primary-foreground text-[11px] font-mono border border-primary" onClick={() => setCount(220)}) 220
              button(className="px-3 py-1.5 rounded-xs bg-card border border-border text-muted-foreground text-[11px] font-mono" onClick={randomizeParticles}) Randomize
        //
        div(className="mt-3 bg-border/15 dark:bg-border/30 border border-border/25 dark:border-border/30 rounded-xl shadow-xs p-3 flex gap-3")
          div(className="text-orange-300 text-[12px]") ●
          div(className="text-[12px] leading-relaxed")
            div(className="font-display font-bold text-foreground tracking-tight") Why Octane wins
            div(className="text-muted-foreground font-mono mt-1") React needs useWorker + Comlink + serialization. Octane worker.bind({particles,gravity}) auto-proxies signals — gravity.set() hits worker without copy.
      div(className="col-span-12 lg:col-span-4 flex flex-col gap-4")
        div(className="bg-card border border-border rounded-xs p-4")
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") METRICS
          div(className="grid grid-cols-3 gap-px bg-border border border-border rounded-xs overflow-hidden mt-3")
            div(className="bg-background p-3 text-center")
              div(className="text-[16px] font-medium text-foreground") #{fps}
              div(className="text-[11px] font-mono text-muted-foreground") FPS
            div(className="bg-background p-3 text-center")
              div(className="text-[16px] font-medium text-accent-1") #{gravity.toFixed(1)}
              div(className="text-[11px] font-mono text-muted-foreground") GRAVITY
            div(className="bg-background p-3 text-center")
              div(className="text-[16px] font-medium text-accent-2") #{count}
              div(className="text-[11px] font-mono text-muted-foreground") COUNT
          div(className="mt-3 space-y-1.5 text-[11px] font-mono")
            div(className="flex justify-between")
              span(className="text-muted-foreground") shared
              span(className="text-foreground") #{shared ? "yes" : "no"}
            div(className="flex justify-between")
              span(className="text-muted-foreground") frame
              span(className="text-foreground") #{frame}
            div(className="flex justify-between")
              span(className="text-muted-foreground") transport
              span(className="text-foreground") #{shared ? "Atomics" : "clone"}
        div(className="bg-card border border-border rounded-xs p-4")
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") BINDING
          pre(className="bg-background border border-border rounded-xs p-3 text-[11px] font-mono leading-relaxed overflow-x-auto mt-2 text-muted-foreground whitespace-pre-wrap break-words")
            code physicsEngine.bind({"{"}particles, gravity{"}"})&#10;// slider → worker instantly
          div(className="text-[11px] font-mono text-muted-foreground mt-2") No postMessage, no serialization — signal is shared.
        div(className="bg-background border border-border rounded-xs p-4")
          div(className="text-[11px] font-mono tracking-wide text-foreground") TIP
          ul(className="list-disc list-inside text-[12px] font-mono text-muted-foreground mt-2 space-y-1")
            li Drag gravity → particles fall faster
            li Change count → spawns without jank
            li Toggle Shared vs Clone to see fps delta
