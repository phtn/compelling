import { useCallback, useEffect, useMemo, useRef, useState } from "octane"
import { cn } from "@/lib/utils"
import Icon from "@/lib/icons/index.btsx"
import Header from "@/components/ui/header.btsx"
import Frame from "@/components/ui/frame.btsx"
import Callout from "@/components/ui/callout.btsx"
import Button from "@/components/ui/button.btsx"
import ButtonGroup from "@/components/ui/button-group.btsx"
import Input from "@/components/ui/input.btsx"
import { acquireCanvasSession, clearCanvasPointer, clearCanvasStrokes, commitCanvasStroke, createCanvasPresenceConnectionId, disconnectCanvasPresence, heartbeatCanvasPresence, undoLastCanvasStroke, updateCanvasNickname, updateCanvasPointer, watchCanvasPointers, watchCanvasRoom, watchCanvasStrokes } from "@/lib/canvas-identity"
import type { CanvasLiveStroke, CanvasPointer, CanvasRoom, CanvasSession, CanvasStroke, CanvasStrokeColor, CanvasStrokeTool } from "@/lib/canvas-identity"

module
  interface Point { x: number; y: number }
  interface Stroke { id: string; points: Point[]; color: CanvasStrokeColor; size: number; tool: CanvasStrokeTool; userId: string }
  const TOOLS: CanvasStrokeTool[] = ["pen-bold", "pencil-bold", "eraser"]
  const COLORS: CanvasStrokeColor[] = ["#e7e7e7","#d7d0fe", 'oklch(0.9 0.072 338.8)',"#ffecba", "oklch(0.68 0.16 319.98)",  '#3a9df6', '#5cffad',"#fe7672", "#525152"]
  const uid = () => Math.random().toString(36).slice(2, 9)
  const nicknameSlice = (value: string) => Array.from(value).slice(0, 24).join("")
  const initialsFor = (nickname: string) => nickname.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase() ?? "").join("") || "?"
  const errorMessage = (error: unknown) => error instanceof Error ? error.message : "Could not connect to the canvas room."
  const HOUR_MS = 60 * 60 * 1000
  const POINTER_THROTTLE_MS = 100
  const PRESENCE_HEARTBEAT_MS = 5000
  const MAX_LIVE_STROKE_POINTS = 512
  const MAX_COMMITTED_STROKE_POINTS = 2048
  const POINTER_COLORS = ["#d7d0fe", "#ffecba", "#fe7672", "#5cffad", "#3a9df6", "oklch(0.68 0.16 319.98)"]
  const pointerColorFor = (sessionId: string) => {
    let hash = 0
    for (const character of sessionId) hash = (hash * 31 + character.charCodeAt(0)) >>> 0
    return POINTER_COLORS[hash % POINTER_COLORS.length]!
  }
  const toStroke = (stroke: CanvasStroke): Stroke => ({ id: stroke.strokeId, points: stroke.points, color: stroke.color, size: stroke.size, tool: stroke.tool, userId: String(stroke.sessionId) })
  const samplePoints = (points: Point[], maximum: number) => {
    if (points.length <= maximum) return points
    const sampled: Point[] = []
    const lastIndex = points.length - 1
    for (let index = 0; index < maximum; index++) {
      sampled.push(points[Math.round((index / (maximum - 1)) * lastIndex)]!)
    }
    return sampled
  }
  const toLiveStroke = (stroke: Stroke): CanvasLiveStroke => ({ strokeId: stroke.id, points: samplePoints(stroke.points, MAX_LIVE_STROKE_POINTS), color: stroke.color, size: stroke.size, tool: stroke.tool })
  const toCommittedStroke = (stroke: Stroke): CanvasLiveStroke => ({ strokeId: stroke.id, points: samplePoints(stroke.points, MAX_COMMITTED_STROKE_POINTS), color: stroke.color, size: stroke.size, tool: stroke.tool })

setup
  const canvasRef = useRef<HTMLCanvasElement | null>(null)
  const containerRef = useRef<HTMLDivElement | null>(null)
  const presenceConnectionIdRef = useRef(createCanvasPresenceConnectionId())
  const pointerTimerRef = useRef<number | undefined>(undefined)
  const pendingPointerRef = useRef<Point | null>(null)
  const lastPointerRef = useRef<Point | null>(null)
  const lastPointerSentAtRef = useRef(0)
  const currentStrokeRef = useRef<Stroke | null>(null)
  const [strokes, setStrokes] = useState<Stroke[]>([])
  const [current, setCurrent] = useState<Stroke | null>(null)
  const [tool, setTool] = useState<CanvasStrokeTool>("pen-bold")
  const [color, setColor] = useState<CanvasStrokeColor>("#525152")
  const [size, setSize] = useState(4)
  const [renderCount, setRenderCount] = useState(0)
  const [lastDelta, setLastDelta] = useState(0)
  const [isDrawing, setIsDrawing] = useState(false)
  const [identity, setIdentity] = useState<CanvasSession | null>(null)
  const [identityStatus, setIdentityStatus] = useState<"loading" | "ready" | "error">("loading")
  const [identityError, setIdentityError] = useState("")
  const [nickname, setNickname] = useState("")
  const [nicknameStatus, setNicknameStatus] = useState<"idle" | "saving" | "saved" | "error">("idle")
  const [room, setRoom] = useState<CanvasRoom | null>(null)
  const [pointers, setPointers] = useState<CanvasPointer[]>([])
  const [leaseVersion, setLeaseVersion] = useState(0)
  const pointsCount = useMemo(() => strokes.reduce((a, s) => a + s.points.length, 0) + (current ? current.points.length : 0), [strokes, current])
  const deltaKb = useMemo(() => (lastDelta / 1024).toFixed(2), [lastDelta])
  const shortIdentity = identity ? String(identity.sessionId).slice(-8).toUpperCase() : "--------"
  const activeUserCount = room?.users.length ?? (identity ? 1 : 0)
  const peerPointers = useMemo(() => pointers.filter((pointer) => pointer.sessionId !== identity?.sessionId), [pointers, identity])
  const committedStrokeIds = useMemo(() => new Set(strokes.map((stroke) => stroke.id)), [strokes])
  const peerLiveStrokes = useMemo(() => peerPointers.flatMap((pointer) => pointer.liveStroke && !committedStrokeIds.has(pointer.liveStroke.strokeId) ? [{ id: pointer.liveStroke.strokeId, points: pointer.liveStroke.points, color: pointer.liveStroke.color, size: pointer.liveStroke.size, tool: pointer.liveStroke.tool, userId: String(pointer.sessionId) }] : []), [peerPointers, committedStrokeIds])
  const getPos = (e: PointerEvent) => {
    const canvas = canvasRef.current
    if (!canvas) return { x: 0, y: 0 }
    const rect = canvas.getBoundingClientRect()
    return { x: (e.clientX - rect.left) * (1400 / rect.width), y: (e.clientY - rect.top) * (800 / rect.height) }
  }
  const flushPointer = () => {
    pointerTimerRef.current = undefined
    const point = pendingPointerRef.current
    pendingPointerRef.current = null
    if (!point || !identity) return
    lastPointerRef.current = point
    lastPointerSentAtRef.current = Date.now()
    const liveStroke = currentStrokeRef.current
    void updateCanvasPointer(identity, point.x, point.y, liveStroke ? toLiveStroke(liveStroke) : undefined)
  }
  const queuePointer = (point: Point) => {
    pendingPointerRef.current = {
      x: Math.max(0, Math.min(100, (point.x / 1400) * 100)),
      y: Math.max(0, Math.min(100, (point.y / 800) * 100)),
    }
    if (pointerTimerRef.current !== undefined) return
    const delay = Math.max(0, POINTER_THROTTLE_MS - (Date.now() - lastPointerSentAtRef.current))
    pointerTimerRef.current = window.setTimeout(flushPointer, delay)
  }
  const clearPointer = () => {
    pendingPointerRef.current = null
    lastPointerRef.current = null
    if (pointerTimerRef.current !== undefined) {
      window.clearTimeout(pointerTimerRef.current)
      pointerTimerRef.current = undefined
    }
    if (identity) void clearCanvasPointer(identity)
  }
  const handlePointerDown = (e: PointerEvent) => {
    const canvas = canvasRef.current
    if (!canvas || !identity) return
    canvas.setPointerCapture(e.pointerId)
    const p = getPos(e)
    const s: Stroke = { id: uid(), points: [p], color, size, tool, userId: String(identity.sessionId) }
    currentStrokeRef.current = s
    setCurrent(s)
    setIsDrawing(true)
    queuePointer(p)
  }
  const handlePointerMove = (e: PointerEvent) => {
    const p = getPos(e)
    queuePointer(p)
    const activeStroke = currentStrokeRef.current
    if (!isDrawing || !activeStroke) return
    const nextStroke = { ...activeStroke, points: [...activeStroke.points, p] }
    currentStrokeRef.current = nextStroke
    setCurrent(nextStroke)
    setLastDelta(nextStroke.points.length * 16)
  }
  const handlePointerUp = (e: PointerEvent) => {
    const finishedStroke = currentStrokeRef.current
    if (!finishedStroke) return
    const canvas = canvasRef.current
    if (canvas) canvas.releasePointerCapture(e.pointerId)
    if (finishedStroke.points.length > 1 && identity) {
      setStrokes((prev) => [...prev.filter((stroke) => stroke.id !== finishedStroke.id), finishedStroke])
      setLastDelta(finishedStroke.points.length * 16)
      void commitCanvasStroke(identity, toCommittedStroke(finishedStroke)).then(() => {
        const pointer = lastPointerRef.current
        if (pointer && currentStrokeRef.current === null) void updateCanvasPointer(identity, pointer.x, pointer.y)
      }).catch((error: unknown) => {
        setStrokes((prev) => prev.filter((stroke) => stroke.id !== finishedStroke.id))
        setIdentityError(errorMessage(error))
      })
    } else if (identity && lastPointerRef.current) {
      void updateCanvasPointer(identity, lastPointerRef.current.x, lastPointerRef.current.y)
    }
    currentStrokeRef.current = null
    setCurrent(null)
    setIsDrawing(false)
    setRenderCount((c) => c + 1)
  }
  const handlePointerLeave = (e: PointerEvent) => {
    handlePointerUp(e)
    clearPointer()
  }
  useEffect(() => {
    let active = true
    let unsubscribeRoom: (() => void) | undefined
    let unsubscribePointers: (() => void) | undefined
    let unsubscribeStrokes: (() => void) | undefined
    let renewalTimer: number | undefined
    let heartbeatTimer: number | undefined
    let presenceSessionToken: string | undefined
    let heartbeatInFlight = false
    setIdentityStatus("loading")
    setIdentityError("")
    setPointers([])
    setStrokes([])
    acquireCanvasSession().then((session) => {
      if (!active) return
      setIdentity(session)
      setNickname(session.nickname)
      setNicknameStatus("idle")
      setIdentityStatus("ready")
      unsubscribeRoom = watchCanvasRoom(
        (nextRoom) => { if (active) setRoom(nextRoom) },
        (error) => { if (active) setIdentityError(errorMessage(error)) },
      )
      unsubscribeStrokes = watchCanvasStrokes(
        session,
        (nextStrokes) => { if (active) setStrokes(nextStrokes.map(toStroke)) },
        (error) => { if (active) setIdentityError(errorMessage(error)) },
      )
      const sendHeartbeat = async () => {
        if (heartbeatInFlight) return
        heartbeatInFlight = true
        try {
          const connection = await heartbeatCanvasPresence(session, presenceConnectionIdRef.current)
          if (!active) {
            void disconnectCanvasPresence(connection.sessionToken)
            return
          }
          presenceSessionToken = connection.sessionToken
          if (!unsubscribePointers) {
            unsubscribePointers = watchCanvasPointers(
              connection.roomToken,
              (nextPointers) => { if (active) setPointers(nextPointers) },
              () => { if (active) setPointers([]) },
            )
          }
        } catch {
          if (active) setPointers([])
        } finally {
          heartbeatInFlight = false
        }
      }
      void sendHeartbeat()
      heartbeatTimer = window.setInterval(() => { void sendHeartbeat() }, PRESENCE_HEARTBEAT_MS)
      renewalTimer = window.setTimeout(
        () => setLeaseVersion((version) => version + 1),
        Math.max(250, session.expiresAt - Date.now() + 250),
      )
    }).catch((error: unknown) => {
      if (!active) return
      setIdentity(null)
      setRoom(null)
      setIdentityStatus("error")
      setIdentityError(errorMessage(error))
      const nextHourStartedAt = (Math.floor(Date.now() / HOUR_MS) + 1) * HOUR_MS
      renewalTimer = window.setTimeout(
        () => setLeaseVersion((version) => version + 1),
        Math.max(250, nextHourStartedAt - Date.now() + 250),
      )
    })
    return () => {
      active = false
      unsubscribeRoom?.()
      unsubscribePointers?.()
      unsubscribeStrokes?.()
      if (heartbeatTimer !== undefined) window.clearInterval(heartbeatTimer)
      if (presenceSessionToken) void disconnectCanvasPresence(presenceSessionToken)
      pendingPointerRef.current = null
      lastPointerRef.current = null
      currentStrokeRef.current = null
      if (pointerTimerRef.current !== undefined) {
        window.clearTimeout(pointerTimerRef.current)
        pointerTimerRef.current = undefined
      }
      if (renewalTimer !== undefined) window.clearTimeout(renewalTimer)
    }
  }, [leaseVersion])
  useEffect(() => {
    const canvas = canvasRef.current
    if (!canvas) return
    const ctx = canvas.getContext("2d")
    if (!ctx) return
    const dpr = window.devicePixelRatio || 1
    const rect = canvas.getBoundingClientRect()
    if (rect.width === 0 || rect.height === 0) return
    canvas.width = rect.width * dpr
    canvas.height = rect.height * dpr
    ctx.scale(dpr, dpr)
    ctx.lineCap = "round"
    ctx.lineJoin = "round"
    const drawStroke = (s: Stroke) => {
      if (s.points.length < 2) return
      ctx.beginPath()
      ctx.strokeStyle = s.tool === "highlighter" ? s.color + "40" : s.color
      ctx.lineWidth = s.tool === "highlighter" ? s.size * 0.6 : s.size
      ctx.globalCompositeOperation = s.tool === "eraser" ? "destination-out" : "source-over"
      ctx.moveTo(s.points[0]!.x * (rect.width / 1400), s.points[0]!.y * (rect.height / 800))
      for (let i = 1; i < s.points.length; i++) {
        const a = s.points[i - 1]!
        const b = s.points[i]!
        const ax = a.x * (rect.width / 1400)
        const ay = a.y * (rect.height / 800)
        const bx = b.x * (rect.width / 1400)
        const by = b.y * (rect.height / 800)
        const cx = (ax + bx) / 2
        const cy = (ay + by) / 2
        ctx.quadraticCurveTo(ax, ay, cx, cy)
      }
      ctx.stroke()
      ctx.globalCompositeOperation = "source-over"
    }
    ctx.clearRect(0, 0, rect.width, rect.height)
    ctx.strokeStyle = "#e3e3e330"
    ctx.lineWidth = 1
    ctx.globalAlpha = 0.5
    for (let x = 0; x < rect.width; x += 40) {
      ctx.beginPath()
      ctx.moveTo(x, 0)
      ctx.lineTo(x, rect.height)
      ctx.stroke()
    }
    for (let y = 0; y < rect.height; y += 40) {
      ctx.beginPath()
      ctx.moveTo(0, y)
      ctx.lineTo(rect.width, y)
      ctx.stroke()
    }
    ctx.globalAlpha = 1
    strokes.forEach(drawStroke)
    peerLiveStrokes.forEach(drawStroke)
    if (current) drawStroke(current)
  }, [strokes, peerLiveStrokes, current])
  const undo = () => {
    if (!identity) return
    const ownStroke = strokes.findLast((stroke) => stroke.userId === String(identity.sessionId))
    if (!ownStroke) return
    setStrokes((previous) => previous.filter((stroke) => stroke.id !== ownStroke.id))
    void undoLastCanvasStroke(identity).catch((error: unknown) => {
      setStrokes((previous) => previous.some((stroke) => stroke.id === ownStroke.id) ? previous : [...previous, ownStroke])
      setIdentityError(errorMessage(error))
    })
  }
  const clearAll = () => {
    const previousStrokes = strokes
    setStrokes([])
    currentStrokeRef.current = null
    setCurrent(null)
    setIsDrawing(false)
    setLastDelta(0)
    if (identity) {
      void clearCanvasStrokes(identity).catch((error: unknown) => {
        setStrokes(previousStrokes)
        setIdentityError(errorMessage(error))
      })
      const pointer = lastPointerRef.current
      if (pointer) void updateCanvasPointer(identity, pointer.x, pointer.y)
    }
  }
  const saveNickname = async () => {
    if (!identity || nicknameStatus === "saving") return
    setNicknameStatus("saving")
    try {
      const updatedIdentity = await updateCanvasNickname(identity, nickname)
      setIdentity(updatedIdentity)
      setNickname(updatedIdentity.nickname)
      setNicknameStatus("saved")
      if (lastPointerRef.current) void updateCanvasPointer(updatedIdentity, lastPointerRef.current.x, lastPointerRef.current.y)
    } catch (error) {
      setNicknameStatus("error")
      setIdentityError(errorMessage(error))
    }
  }
  const handleNicknameKeyDown = (event: KeyboardEvent) => {
    if (event.key !== "Enter") return
    event.preventDefault()
    void saveNickname()
  }

  const [showInfo, setShowInfo] = useState(false)
  const toggleInfo = useCallback(() => setShowInfo((s) => !s), [])
  const info = {
    title: "Realtime drawing",
    text: "Convex presence carries cursors and in-progress strokes at a throttled cadence. Completed strokes are stored once, reactively shared, and restored after refresh for the rest of the hour.",
  }

div.bg-background
  div(className="w-full px-0 sm:px-3 md:px-4 lg:px-5 xl:px-6 py-0 md:py-6")
    Header(title="Canvas" subtitle="GRANULAR REACTIVITY" icon='mechanics'
      ~ description="Local ink follows the pointer immediately while Convex broadcasts live peer strokes and cursors. Completed strokes persist in the hourly room and reload after refresh."
      ~ isVisible={showInfo} toggleFn={toggleInfo} actions={[]} className='hidden md:flex')

    div(className="grid grid-cols-12 gap-4")
      div(className="col-span-12 lg:col-span-9 flex flex-col gap-4")
        Frame(title={tool} className="relative border-0 md:border"
          ~ // subtitle={strokes.length + " ST \u00b7 " + pointsCount + " PT \u00b7 " + deltaKb + " KB"}
          ~ titlebar={false} )
          Icon(name='person' onClick={undefined} className="size-6 absolute top-1 right-8" )
          Icon(name='clear' onClick={clearAll} className="size-6 absolute top-1 right-1.5 text-[#ee705d]" )

          div(className="relative bg-white keep-white w-full h-[clamp(240px,calc(100dvh-216px),500px)] md:h-[500px] overflow-hidden" ref={containerRef} style="")
            canvas(className="block w-full h-full touch-none bg-background" ref={canvasRef} width={1400} height={800} style="width:100%;height:100%;cursor:crosshair" onPointerDown={handlePointerDown} onPointerMove={handlePointerMove} onPointerUp={handlePointerUp} onPointerLeave={handlePointerLeave} onPointerCancel={handlePointerLeave})
            each pointer in peerPointers key pointer.sessionId
              div(className="absolute z-10 pointer-events-none transition-[left,top] duration-100 ease-linear" style={"left:" + pointer.x + "%;top:" + pointer.y + "%"})
                div(className="text-[22px] leading-none -translate-x-1 -translate-y-1 drop-shadow-sm" style={"color:" + pointerColorFor(String(pointer.sessionId))}) ↖
                div(className="ml-3 -mt-1 max-w-32 truncate rounded-sm border border-white/70 px-1.5 py-0.5 text-[10px] font-mono font-medium text-[#121212] shadow-sm" style={"background:" + pointerColorFor(String(pointer.sessionId))}) #{pointer.nickname}


          // CONTROLS
          div(className="grid grid-cols-2 gap-1.5 border-t border-border/50 p-2 sm:flex sm:items-center sm:justify-evenly sm:gap-3 sm:p-3")
            div(className="flex min-w-0 items-center justify-self-start sm:justify-self-auto")
              ButtonGroup(size="lg" className="max-w-full")
                Button(size='icon' icon={'undo'} iconStyle='size-5 sm:size-6' onClick={undo} variant="outline" aria-label={'undo'})
                each t in TOOLS key t
                  Button(size='icon' icon={t} iconStyle='size-5 sm:size-6' onClick={() => setTool(t)} className={tool === t ? 'bg-border/20 border border-border/30 rounded-lg' : `border border-border/0`} variant="outline" aria-label={t})
            div(className="col-span-2 row-start-1 flex min-w-0 items-center justify-center sm:col-auto sm:row-auto")
              ButtonGroup(size="lg" className="max-w-full")
                each c, i in COLORS key c
                  Button(size='icon' label='●' onClick={() => setColor(c)} className={cn(`min-w-12 border border-border/0 bg-[${c}] text-foreground/0`, {'bg-border/40 border border-border/30 text-muted-foreground': color === c, 'text-muted': color === c && i === COLORS.length - 1}) } variant="outline" label='●' aria-label={"Use color " + c} style={"background: " + c})
            div(className="flex min-w-0 items-center justify-self-end sm:justify-self-auto")
              ButtonGroup(size="lg" className="max-w-full")
                each s in [2,6, 10, 14] key s
                  Button(size='sm' onClick={() => setSize(s)} className={cn('min-w-12 px-2 border border-border/0 text-base!', {'px-2 bg-border/20 border border-border/30': size === s})} variant="outline" label={s})
          div(className="flex flex-col gap-2 border-t border-border/50 bg-background p-3 sm:flex-row sm:items-center")
            div(className="min-w-0 sm:w-52")
              div(className="text-[10px] font-mono tracking-wide text-muted-foreground") HOURLY ID · #{shortIdentity}
              if identityStatus === "loading"
                div(className="mt-1 text-[11px] font-mono text-muted-foreground") Joining canvas…
              elseif identityStatus === "error"
                div(className="mt-1 truncate text-[11px] font-mono text-destructive" title={identityError}) #{identityError || "Connection unavailable"}
              elseif nicknameStatus === "error"
                div(className="mt-1 truncate text-[11px] font-mono text-destructive" title={identityError}) Nickname was not saved
              else
                div(className="mt-1 text-[11px] font-mono text-muted-foreground") #{activeUserCount}/#{room?.maxUsers ?? 100} slots · resets hourly
            div(className="flex min-w-0 flex-1 gap-2")
              Input(value={nickname} placeholder="Type a nickname" disabled={!identity || nicknameStatus === "saving"} onChange={(value) => { setNickname(nicknameSlice(value)); setNicknameStatus("idle") }} onKeyDown={handleNicknameKeyDown} inputClassName="h-9")
              Button(size="sm" variant="primary" label={nicknameStatus === "saving" ? "Saving…" : nicknameStatus === "saved" ? "Saved" : "Save"} disabled={!identity || nicknameStatus === "saving"} onClick={() => { void saveNickname() }})

        div(className="hidden md:block bg-card border border-border rounded-xl p-4")
          div(className="flex items-center justify-between text-[11px] font-mono tracking-wide")
            span(className="text-muted-foreground") PERFORMANCE
            span(className="text-foreground") LIVE CANVAS METRICS
          div(className="mt-3 grid grid-cols-4 gap-px overflow-hidden rounded-xl border border-border bg-border text-center font-mono")
            div(className="bg-background p-3")
              div(className="text-[15px] font-medium text-foreground") #{renderCount}
              div(className="mt-1 text-[10px] text-muted-foreground") RERENDERS
            div(className="bg-background p-3")
              div(className="text-[15px] font-medium text-foreground") #{strokes.length}
              div(className="mt-1 text-[10px] text-muted-foreground") STROKES
            div(className="bg-background p-3")
              div(className="text-[15px] font-medium text-foreground") #{pointsCount}
              div(className="mt-1 text-[10px] text-muted-foreground") POINTS
            div(className="bg-background p-3")
              div(className="text-[15px] font-medium text-foreground") #{deltaKb} KB
              div(className="mt-1 text-[10px] text-muted-foreground") EST. DELTA
          div(className="mt-3 text-[11px] leading-relaxed text-muted-foreground font-mono") The canvas redraws from stroke data while Octane updates the surrounding counters and controls independently.
        Callout(title={info.title} text={info.text} className="mx-2 mb-2 md:m-0")
      div(className="hidden col-span-12 lg:col-span-3 md:flex flex-col gap-3")
        div(className="bg-card rounded-xl border border-border/50 p-3")
          div(className="flex items-center justify-between")
            div(className="text-[11px] font-mono tracking-wide text-muted-foreground") SYNC
            div(className="size-2 rounded-xs bg-border")
          div(className="flex items-center gap-2 mt-2 text-[12px]")
            div(className="size-2 rounded-xs bg-border")
            span(className="text-foreground font-medium font-mono") #{identityStatus === "ready" ? "Connected" : identityStatus === "loading" ? "Connecting" : "Offline"}
          div(className="text-[11px] font-mono text-muted-foreground mt-2") Last delta: #{deltaKb} KB · #{pointsCount} pts
          div(className="text-[11px] font-mono text-muted-foreground") Renders: #{renderCount} · users: #{activeUserCount} · cursors: #{peerPointers.length} · live strokes: #{peerLiveStrokes.length}
          div(className="w-full h-1 bg-border rounded-xs mt-3 overflow-hidden")
            div(className="h-1 bg-accent-1" style={"width:" + Math.min(100, renderCount * 4) + "%"})
          div(className="text-[11px] text-muted-foreground leading-relaxed font-mono mt-2") Tip: Drag on the canvas. Peers see the stroke while it is being drawn, and completed ink remains for the current hour.
        div(className="rounded-xs mt-4")
          div(className="flex items-center justify-between")
            div(className="text-[11px] font-mono tracking-wide text-muted-foreground") ACTIVE USERS — #{activeUserCount}
            div(className="w-1.5 h-1.5 rounded-xs bg-accent-2")
          div(className="flex max-h-72 flex-col mt-3 rounded-xl bg-secondary border border-border/50 overflow-y-auto")
            if room && room.users.length > 0
              each user in room.users key user.sessionId
                div(className={user.sessionId === identity?.sessionId ? "flex items-center gap-3 p-2" : "flex items-center gap-3 p-2 rounded-xs bg-background"})
                  div(className="w-7 h-7 rounded-sm grid place-items-center font-mono font-medium text-foreground text-[10px] border border-primary") #{initialsFor(user.nickname)}
                  div(className="flex-1 min-w-0")
                    div(className="text-[12px] font-medium text-foreground truncate") #{user.nickname}#{user.sessionId === identity?.sessionId ? " · You" : ""}
                    div(className="text-[11px] font-mono text-muted-foreground") ID #{String(user.sessionId).slice(-8).toUpperCase()}
                  div(className={user.sessionId === identity?.sessionId ? "w-1.5 h-1.5 rounded-xs bg-primary" : "w-1.5 h-1.5 rounded-xs bg-accent-2"})
            else
              div(className="p-3 text-[11px] font-mono text-muted-foreground") No active users yet
          div(className="mt-3 grid grid-cols-3 gap-px bg-border border border-border rounded-xl overflow-hidden text-center text-[11px] font-mono")
            div(className="bg-background p-2")
              div(className="font-medium text-foreground") #{(pointsCount * 0.016).toFixed(1)}KB
              div(className="text-muted-foreground") TOTAL
            div(className="bg-background p-2")
              div(className="font-medium text-foreground") #{peerPointers.length}
              div(className="text-muted-foreground") CURSORS
            div(className="bg-background p-2")
              div(className="font-medium text-foreground") 0.8ms
              div(className="text-muted-foreground") DIFF
        div(className="rounded-xs mt-8")
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") STROKE HISTORY
          div(className="flex flex-col gap-1.5 mt-3 max-h-72 overflow-auto pr-1 rounded-xl bg-secondary border border-border")
            if strokes.length === 0
              div(className="text-[12px] text-muted-foreground font-mono italic p-2") No strokes yet — draw on canvas
            each s, i in strokes.slice().reverse().slice(0, 8) key s.id
              div(className="flex items-center gap-3 p-2")
                div(className="w-7 h-7 rounded-xl border border-primary shadow-sm" style={"background:" + s.color})
                div(className="flex-1 min-w-0")
                  div(className="text-[11px] font-mono font-medium text-foreground truncate") #{s.tool} · #{s.points.length} pts · #{s.userId}
                  div(className="text-[11px] font-mono text-muted-foreground") #{s.id} · #{s.size}px
                div(className="text-[11px] font-mono text-muted-foreground") ##{strokes.length - i}
