import { useCallback, useEffect, useMemo, useRef, useState } from "octane"
import { cn } from "@/lib/utils"
import Icon from "@/lib/icons/index.btsx"
import Header from "@/components/ui/header.btsx"
import Frame from "@/components/ui/frame.btsx"
import Button from "@/components/ui/button.btsx"
import ButtonGroup from "@/components/ui/button-group.btsx"

module
  interface Point { x: number; y: number }
  interface Stroke { id: string; points: Point[]; color: string; size: number; tool: string; userId: string }
  interface Peer { id: string; name: string; color: string; x: number; y: number; initials: string }
  const TOOLS = ["pen", "highlighter", "eraser"]
  const COLORS = ["#dedede", "#d7d0fe", "#ffecba", "#fe7672", "#cee1e7", "#e7e7e7", "#525152"]
  const PEERS: Peer[] = [
    { id: "p1", name: "Alex Chen", color: "#d7d0fe", x: 22, y: 34, initials: "AC" },
    { id: "p2", name: "Maya Patel", color: "#ffecba", x: 68, y: 52, initials: "MP" },
    { id: "p3", name: "Jordan Lee", color: "#fe7672", x: 44, y: 78, initials: "JL" },
  ]
  const uid = () => Math.random().toString(36).slice(2, 9)

props {}: {}

setup
  const canvasRef = useRef<HTMLCanvasElement | null>(null)
  const containerRef = useRef<HTMLDivElement | null>(null)
  const [strokes, setStrokes] = useState<Stroke[]>(() => [
    { id: "s1", points: [{ x: 40, y: 40 }, { x: 120, y: 60 }, { x: 180, y: 45 }, { x: 220, y: 70 }], color: "#000000", size: 4, tool: "pen", userId: "you" },
    { id: "s2", points: [{ x: 60, y: 120 }, { x: 100, y: 140 }, { x: 160, y: 130 }, { x: 200, y: 150 }], color: "#404040", size: 8, tool: "highlighter", userId: "p1" },
    { id: "s3", points: [{ x: 300, y: 80 }, { x: 340, y: 110 }, { x: 380, y: 90 }], color: "#fe7672", size: 3, tool: "pen", userId: "p2" },
  ])
  const [current, setCurrent] = useState<Stroke | null>(null)
  const [tool, setTool] = useState("pen")
  const [color, setColor] = useState("#000000")
  const [size, setSize] = useState(4)
  const [peers, setPeers] = useState<Peer[]>(PEERS)
  const [showPeers, setShowPeers] = useState(true)
  const [renderCount, setRenderCount] = useState(0)
  const [lastDelta, setLastDelta] = useState(0)
  const [isDrawing, setIsDrawing] = useState(false)
  const pointsCount = useMemo(() => strokes.reduce((a, s) => a + s.points.length, 0) + (current ? current.points.length : 0), [strokes, current])
  const deltaKb = useMemo(() => (lastDelta / 1024).toFixed(2), [lastDelta])
  const getPos = (e: PointerEvent) => {
    const canvas = canvasRef.current
    if (!canvas) return { x: 0, y: 0 }
    const rect = canvas.getBoundingClientRect()
    return { x: (e.clientX - rect.left) * (1400 / rect.width), y: (e.clientY - rect.top) * (800 / rect.height) }
  }
  const handlePointerDown = (e: PointerEvent) => {
    const canvas = canvasRef.current
    if (!canvas) return
    canvas.setPointerCapture(e.pointerId)
    const p = getPos(e)
    const s: Stroke = { id: uid(), points: [p], color: tool === "eraser" ? "#ffffff" : color, size: tool === "highlighter" ? size * 3 : size, tool, userId: "you" }
    setCurrent(s)
    setIsDrawing(true)
  }
  const handlePointerMove = (e: PointerEvent) => {
    if (!isDrawing || !current) return
    const p = getPos(e)
    setCurrent({ ...current, points: [...current.points, p] })
    setLastDelta(current.points.length * 8 + Math.floor(Math.random() * 20))
    setPeers((prev) => prev.map((q, idx) => idx === 0 ? { ...q, x: (p.x / 1400) * 100, y: (p.y / 800) * 100 } : q))
  }
  const handlePointerUp = (e: PointerEvent) => {
    if (!current) return
    const canvas = canvasRef.current
    if (canvas) canvas.releasePointerCapture(e.pointerId)
    if (current.points.length > 1) {
      setStrokes((prev) => [...prev, current])
      setLastDelta(current.points.length * 16)
    }
    setCurrent(null)
    setIsDrawing(false)
    setRenderCount((c) => c + 1)
  }
  useEffect(() => {
    const canvas = canvasRef.current
    if (!canvas) return
    const ctx = canvas.getContext("2d")
    if (!ctx) return
    const dpr = window.devicePixelRatio || 1
    const rect = canvas.getBoundingClientRect()
    if (rect.width === 0 || rect.height === 0) return
    canvas.width = rect.width * dpr
    canvas.height = rect.height * dpr
    ctx.scale(dpr, dpr)
    ctx.lineCap = "round"
    ctx.lineJoin = "round"
    const drawStroke = (s: Stroke) => {
      if (s.points.length < 2) return
      ctx.beginPath()
      ctx.strokeStyle = s.tool === "highlighter" ? s.color + "40" : s.color
      ctx.lineWidth = s.tool === "highlighter" ? s.size * 0.6 : s.size
      ctx.globalCompositeOperation = s.tool === "eraser" ? "destination-out" : "source-over"
      ctx.moveTo(s.points[0]!.x * (rect.width / 1400), s.points[0]!.y * (rect.height / 800))
      for (let i = 1; i < s.points.length; i++) {
        const a = s.points[i - 1]!
        const b = s.points[i]!
        const ax = a.x * (rect.width / 1400)
        const ay = a.y * (rect.height / 800)
        const bx = b.x * (rect.width / 1400)
        const by = b.y * (rect.height / 800)
        const cx = (ax + bx) / 2
        const cy = (ay + by) / 2
        ctx.quadraticCurveTo(ax, ay, cx, cy)
      }
      ctx.stroke()
      ctx.globalCompositeOperation = "source-over"
    }
    ctx.clearRect(0, 0, rect.width, rect.height)
    ctx.strokeStyle = "#e5e5e5"
    ctx.lineWidth = 1
    ctx.globalAlpha = 0.5
    for (let x = 0; x < rect.width; x += 40) {
      ctx.beginPath()
      ctx.moveTo(x, 0)
      ctx.lineTo(x, rect.height)
      ctx.stroke()
    }
    for (let y = 0; y < rect.height; y += 40) {
      ctx.beginPath()
      ctx.moveTo(0, y)
      ctx.lineTo(rect.width, y)
      ctx.stroke()
    }
    ctx.globalAlpha = 1
    strokes.forEach(drawStroke)
    if (current) drawStroke(current)
  }, [strokes, current])
  useEffect(() => {
    const t = window.setInterval(() => {
      setPeers((prev) => prev.map((p) => ({ ...p, x: Math.max(5, Math.min(95, p.x + (Math.random() - 0.5) * 8)), y: Math.max(5, Math.min(95, p.y + (Math.random() - 0.5) * 8)) })))
    }, 900)
    return () => window.clearInterval(t)
  }, [])
  useEffect(() => {
    const t = window.setInterval(() => {
      if (Math.random() > 0.65 && !isDrawing) {
        const peer = peers[Math.floor(Math.random() * peers.length)]!
        const sx = 80 + Math.random() * 1200
        const sy = 80 + Math.random() * 640
        const pts: Point[] = []
        let cx = sx
        let cy = sy
        for (let i = 0; i < 6 + Math.floor(Math.random() * 8); i++) {
          cx += (Math.random() - 0.5) * 40
          cy += (Math.random() - 0.5) * 24
          pts.push({ x: cx, y: cy })
        }
        const s: Stroke = { id: uid(), points: pts, color: peer.color, size: 3 + Math.floor(Math.random() * 3), tool: Math.random() > 0.8 ? "highlighter" : "pen", userId: peer.id }
        setStrokes((prev) => [...prev.slice(-60), s])
        setLastDelta(pts.length * 16)
        setRenderCount((c) => c + 1)
      }
    }, 2400)
    return () => window.clearInterval(t)
  }, [peers, isDrawing])
  const undo = () => setStrokes((p) => p.slice(0, -1))
  const clearAll = () => {
    setStrokes([])
    setCurrent(null)
    setLastDelta(0)
  }

  const [showInfo, setShowInfo] = useState(false)
  const toggleInfo = useCallback(() => setShowInfo((s) => !s), [])
  const actions = [
    {id: "eraser", icon: "eraser", onClick: clearAll, className: ""},
    {id: "undo", icon: "undo", onClick: undo, className: ""},
    {id: "users", icon: "users", onClick: () => setShowPeers(!showPeers), className: "" + (showPeers ? "" : "")} ]

div.bg-background
  div(className="w-full px-6 py-6")
    Header(title="Real-Time Canvas" subtitle="GRANULAR REACTIVITY" icon='mechanics' description="Only re-renders changed pixels via Octane's fine-grained reactivity. Delta sync sends 16 bytes per point, not full canvas. Presence cursors, WebSocket deltas, 60fps pointer capture." isVisible={showInfo} toggleFn={toggleInfo} actions={actions})

    div(className="grid grid-cols-12 gap-4")
      div(className="col-span-12 lg:col-span-9 flex flex-col gap-4")
        Frame(title={"1400\u00d7800 \u00b7 " + tool} subtitle={strokes.length + " ST \u00b7 " + pointsCount + " PT \u00b7 " + deltaKb + " KB"})
          div(className="relative bg-white keep-white w-full h-[500px] overflow-hidden" ref={containerRef} style="background:#fff")
            canvas(className="block w-full h-full touch-none bg-white keep-white" ref={canvasRef} width={1400} height={800} style="width:100%;height:100%;cursor:crosshair;background:#fff" onPointerDown={handlePointerDown} onPointerMove={handlePointerMove} onPointerUp={handlePointerUp} onPointerLeave={handlePointerUp})
            if showPeers
              fragment
                each peer in peers key peer.id
                  div(className="absolute pointer-events-none transition-all duration-700 ease-out" style={"left:" + peer.x + "%;top:" + peer.y + "%"})
                    div(className="flex items-center gap-1 -translate-x-1 -translate-y-1")
                      div(className="w-2.5 h-2.5 rounded-xs border border-primary/50 shadow-sm" style={"background:" + peer.color})
                      div(className="px-1.5 py-0.5 rounded-xs text-[10px] font-mono font-medium text-foreground shadow border border-primary/20" style={"background:" + peer.color}) #{peer.initials}
                div(className="absolute pointer-events-none" style="left:12%;top:18%")
                  div(className="w-2.5 h-2.5 rounded-xs bg-background border border-primary shadow-sm")
                  div(className="px-1.5 py-0.5 rounded-xs bg-background text-foreground text-[10px] font-mono font-medium -translate-x-2 mt-1 border border-primary") YOU


          // CONTROLS
          div(className="border-t border-border/50 p-3 flex items-center justify-evenly gap-3")
            div(className="flex items-center gap-2")
              ButtonGroup(size="sm")
                each t in TOOLS key t
                  Button(size='sm' onClick={() => setTool(t)} className={tool === t ? 'bg-border/20 border border-border/30 rounded-lg' : `border border-border/0`} variant="outline" label={t} attached={true} )
            div(className="flex items-center gap-2")
              span(className="text-[10px] font-mono tracking-wide text-muted-foreground") COLOR
              ButtonGroup(size="sm")
                each c in COLORS key c
                  Button(size='sm' onClick={() => setColor(c)} className={color === c ? 'bg-border/20 border border-border/30' : `border border-border/0 bg-[${c}] text-foreground/0`} variant="outline" attached={true} label={color === c ? '●' : '●'} style={"background: " + c})
            div(className="flex items-center gap-2")
              span(className="text-[10px] font-mono tracking-wide text-muted-foreground") SIZE
              ButtonGroup(size="sm")
                each s in [2,4,7,12] key s
                  Button(size='sm' onClick={() => setSize(s)} className={size === s ? 'bg-border/20 border border-border/30' : 'border border-border/0'} variant="outline" label={s} attached={true} )

        div(className="bg-card border border-border rounded-xs p-4")
          div(className="flex items-center space-x-4 text-[11px] font-mono tracking-wide text-muted-foreground")
            span PERFORMANCE
            span Re-renders (granular) #{renderCount}
          div(className="mt-3 space-y-3 text-[11px] font-mono")
            div
              div(className="w-full h-1 bg-border rounded-xs mt-1 overflow-hidden")
                div(className="h-1 bg-accent-1" style={"width:" + Math.min(100, renderCount * 4) + "%"})
            div
              div(className="flex justify-between")
                span(className="text-muted-foreground") Virtual DOM avoided
                span(className="font-medium text-foreground") 100%
              div(className="w-full h-1 bg-border rounded-xs mt-1 overflow-hidden")
                div(className="h-1 bg-accent-2" style="width:100%")
            div(className="text-muted-foreground leading-relaxed font-mono") Octane tracks strokes and current separately. Only the stroke being drawn updates.
        div(className="bg-card border border-border rounded-xs p-3 flex gap-3")
          div(className="text-muted-foreground text-[12px] font-mono") ●
          div(className="text-[12px] leading-relaxed font-mono")
            div(className="font-medium text-foreground") Why Octane wins
            div(className="text-muted-foreground mt-1") React re-renders the whole canvas tree on mousemove; Svelte needs manual hints. Octane tracks strokes.delta granularly — only current.points invalidates.
      div(className="col-span-12 lg:col-span-3 flex flex-col gap-3")
        div(className="bg-card rounded-xs p-3")
          div(className="flex items-center justify-between")
            div(className="text-[11px] font-mono tracking-wide text-muted-foreground") SYNC
            div(className="w-1.5 h-1.5 rounded-xs bg-accent-2")
          div(className="flex items-center gap-2 mt-2 text-[12px]")
            div(className="w-1.5 h-1.5 rounded-xs bg-accent-2")
            span(className="text-foreground font-medium font-mono") Connected
          div(className="text-[11px] font-mono text-muted-foreground mt-2") Last delta: #{deltaKb} KB · #{pointsCount} pts
          div(className="text-[11px] font-mono text-muted-foreground") Renders: #{renderCount} · peers: #{peers.length + 1}
          div(className="w-full h-1 bg-border rounded-xs mt-3 overflow-hidden")
            div(className="h-1 bg-accent-1" style={"width:" + Math.min(100, renderCount * 4) + "%"})
          div(className="text-[11px] text-muted-foreground leading-relaxed font-mono mt-2") Tip: Drag on canvas. Highlighter is translucent. Peers simulated every 2.4s.
        div(className="bg-card rounded-xs mt-8")
          div(className="flex items-center justify-between")
            div(className="text-[11px] font-mono tracking-wide text-muted-foreground") ACTIVE USERS — #{peers.length + 1}
            div(className="w-1.5 h-1.5 rounded-xs bg-accent-2")
          div(className="flex flex-col gap-1.5 mt-3")
            div(className="flex items-center gap-3 p-2 rounded-xs bg-primary text-primary-foreground border border-primary")
              div(className="w-7 h-7 rounded-xs bg-background text-foreground grid place-items-center font-mono font-medium text-[10px]") YO
              div(className="flex-1")
                div(className="text-[12px] font-medium") You
                div(className="text-[11px] font-mono text-muted-foreground") Drawing · #{tool}
              div(className="w-1.5 h-1.5 rounded-xs bg-accent-2")
            each peer in peers key peer.id
              div(className="flex items-center gap-3 p-2 rounded-xs bg-background border border-border")
                div(className="w-7 h-7 rounded-xs grid place-items-center font-mono font-medium text-foreground text-[10px] border border-primary" style={"background:" + peer.color}) #{peer.initials}
                div(className="flex-1")
                  div(className="text-[12px] font-medium text-foreground") #{peer.name}
                  div(className="text-[11px] font-mono text-muted-foreground") Cursor #{Math.round(peer.x)}%, #{Math.round(peer.y)}%
                div(className="w-1.5 h-1.5 rounded-xs bg-accent-2")
          div(className="mt-3 grid grid-cols-3 gap-px bg-border border border-border rounded-xs overflow-hidden text-center text-[11px] font-mono")
            div(className="bg-background p-2")
              div(className="font-medium text-foreground") #{(pointsCount * 0.016).toFixed(1)}KB
              div(className="text-muted-foreground") TOTAL
            div(className="bg-background p-2")
              div(className="font-medium text-foreground") 60fps
              div(className="text-muted-foreground") POINTER
            div(className="bg-background p-2")
              div(className="font-medium text-foreground") 0.8ms
              div(className="text-muted-foreground") DIFF
        div(className="bg-card rounded-xs mt-8")
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") STROKE HISTORY
          div(className="text-[11px] font-mono text-muted-foreground mt-1") Latest 8 strokes, newest first
          div(className="flex flex-col gap-1.5 mt-3 max-h-72 overflow-auto pr-1")
            if strokes.length === 0
              div(className="text-[12px] text-muted-foreground font-mono italic") No strokes yet — draw on canvas
            each s, i in strokes.slice().reverse().slice(0, 8) key s.id
              div(className="flex items-center gap-3 p-2 rounded-xs bg-background border border-border")
                div(className="w-7 h-7 rounded-xs border border-primary shadow-sm" style={"background:" + s.color})
                div(className="flex-1 min-w-0")
                  div(className="text-[11px] font-mono font-medium text-foreground truncate") #{s.tool} · #{s.points.length} pts · #{s.userId}
                  div(className="text-[11px] font-mono text-muted-foreground") #{s.id} · #{s.size}px
                div(className="text-[11px] font-mono text-muted-foreground") ##{strokes.length - i}
