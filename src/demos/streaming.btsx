import { useEffect, useMemo, useState } from "octane"
import Header from "@/components/ui/header.btsx"
import Frame from "@/components/ui/frame.btsx"
import Callout from "@/components/ui/callout.btsx"

module
  interface Result { id: string; title: string; excerpt: string; score: number; cached: boolean }

props {}: {}

setup
  const [query, setQuery] = useState("octane")
  const [results, setResults] = useState<Result[]>([])
  const [streaming, setStreaming] = useState(false)
  const [cacheHits, setCacheHits] = useState(0)
  const [edgeMs, setEdgeMs] = useState(0)
  const [hydrated, setHydrated] = useState(0)
  const cache = useMemo(() => new Map<string, Result[]>(), [])
  const all = useMemo(() => [
    { id: "r1", title: "Octane — granular reactivity without VDOM", excerpt: "Fine-grained signals, delta sync, 0.8ms diff. No virtual DOM.", score: 0.98, cached: false },
    { id: "r2", title: "Timeline — time as dimension", excerpt: "Every signal gets .timeline() with structural sharing and branching.", score: 0.96, cached: false },
    { id: "r3", title: "Worker — SharedArrayBuffer auto-proxy", excerpt: "Signals live in worker, reactive in main. No postMessage.", score: 0.94, cached: false },
    { id: "r4", title: "Motion — interruptible springs", excerpt: "Separate animation loop, gesture velocity preserved, mode: interrupt.", score: 0.92, cached: false },
    { id: "r5", title: "Streaming — edge HTML chunks", excerpt: "Cloudflare/Deno Deploy streams <result-card> as it arrives.", score: 0.9, cached: false },
    { id: "r6", title: "Canvas — 60fps delta sync", excerpt: "Only current.points invalidates, not 60 prior strokes.", score: 0.88, cached: false },
  ], [])
  const onQueryInput = (e: Event) => setQuery((e.target as HTMLInputElement).value)
  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase()
    if (!q) return []
    return all.filter((r) => r.title.toLowerCase().includes(q) || r.excerpt.toLowerCase().includes(q))
  }, [query, all])
  const startStream = () => {
    const q = query.trim()
    if (!q) return
    const key = q.toLowerCase()
    const hit = cache.get(key)
    if (hit) {
      setResults(hit)
      setCacheHits((c) => c + 1)
      setEdgeMs(8)
      setHydrated(hit.length)
      return
    }
    setStreaming(true)
    setResults([])
    setHydrated(0)
    const start = performance.now()
    let idx = 0
    const src = filtered.length ? filtered : all.slice(0, 3)
    const t = window.setInterval(() => {
      if (idx < src.length) {
        const r = { ...src[idx]!, cached: false }
        setResults((prev) => [...prev, r])
        setHydrated((n) => n + 1)
        idx++
      } else {
        window.clearInterval(t)
        setStreaming(false)
        const ms = Math.round(performance.now() - start)
        setEdgeMs(ms)
        cache.set(key, [...src].map((r) => ({ ...r, cached: false })))
      }
    }, 280)
  }
  useEffect(() => {
    startStream()
  }, [])
  const [showInfo, setShowInfo] = useState(false)
  const toggleInfo = () => setShowInfo(!showInfo)
  useEffect(() => {
    const t = window.setTimeout(() => startStream(), 320)
    return () => window.clearTimeout(t)
  }, [query])

  const actions = [
    {id: "stream", label: "Stream", onClick: startStream, className: ""}]

  const info = {
    title: "Why Octane wins",
    text: "Next.js Server Components need Vercel infra + poor partial streaming. Octane runs in Cloudflare/Deno Deploy, streams actual HTML chunks that hydrate incrementally.",
  }

div.bg-background
  div(className="w-full px-2 sm:px-3 md:px-4 lg:px-5 xl:px-6 py-6")
    Header(title="Streaming" subtitle="STREAMING EDGE AT CDN" icon='mechanics' description="Server components that stream progressively from edge — yield <skeleton> then each <result-card> hydrates as it arrives. Keyed cache at CDN." isVisible={showInfo} toggleFn={toggleInfo} actions={actions})
    div(className="grid grid-cols-12 gap-4")
      div(className="col-span-12 lg:col-span-8 flex flex-col gap-4")
        Frame(title={"Stream \u00b7 " + query + " \u00b7 " + results.length + " results"} subtitle={edgeMs + "ms edge \u00b7 " + cacheHits + " hits \u00b7 " + hydrated + "/" + results.length + " hydrated" + (streaming ? " \u00b7 streaming" : "")})
          div(className="p-4")
            div(className="relative")
              input(className="w-full bg-background border border-input rounded-sm px-4 py-3 text-[13px] font-mono text-foreground placeholder:text-muted-foreground focus:outline-none focus:border-accent-1" value={query} placeholder="Search — try octane, timeline, worker" onInput={onQueryInput})
            div(className="mt-3 flex gap-1.5 flex-wrap")
              each t in ["octane", "timeline", "worker", "motion", "canvas"] key t
                button(className={"px-2.5 py-1 rounded-sm border text-[11px] font-mono " + (query === t ? "bg-foreground text-background border-foreground" : "bg-background border-border text-muted-foreground hover:text-foreground hover:border-input")} onClick={() => setQuery(t)}) #{t}
            div(className="mt-4 space-y-2 min-h-[320px]")
              if streaming && results.length === 0
                each n in [1,2,3,4,5] key n
                  div(className="h-16 bg-background border border-border rounded-xs animate-pulse")
              each r in results key r.id
                div(className="p-3 bg-background border border-border rounded-sm hover:border-input transition")
                  div(className="flex items-start justify-between gap-2")
                    div(className="text-[13px] font-medium text-foreground") #{r.title}
                    span(className={"px-1.5 py-0.5 rounded-sm text-[10px] font-mono border " + (r.cached ? "bg-accent-2 text-foreground border-accent-2" : "bg-card text-muted-foreground border-border")}) #{r.score.toFixed(2)} #{r.cached ? "· cached" : ""}
                  p(className="text-[12px] font-mono text-muted-foreground mt-1 leading-relaxed") #{r.excerpt}
                  div(className="mt-2 text-[11px] font-mono text-muted-foreground") Hydrated ✓ · streamed as HTML chunk — no JSON boundary
              if !streaming && results.length === 0
                div(className="p-8 text-center border border-dashed border-border rounded-xs bg-background")
                  div(className="text-[13px] font-mono text-muted-foreground") No results — try octane
              if streaming
                div(className="h-1 bg-border rounded-xs overflow-hidden")
                  div(className="h-1 bg-accent-1 transition-all" style={"width:" + Math.round((results.length / (filtered.length || 3)) * 100) + "%"})
            div(className="mt-3 text-[11px] font-mono text-muted-foreground") Yield &lt;skeleton&gt; instantly, then each &lt;result-card&gt; streams → client hydrates before full response ends.
        Callout(title={info.title} text={info.text})
      div(className="col-span-12 lg:col-span-4 flex flex-col gap-4")
        div(className="bg-card border border-border rounded-xl p-4")
          div(className="text-[11px] font-mono tracking-wide text-muted-foreground") EDGE METRICS
          div(className="grid grid-cols-3 gap-px bg-border border border-border rounded-lg overflow-hidden mt-3")
            div(className="bg-background p-3 text-center")
              div(className="text-[16px] font-medium text-foreground") #{edgeMs}ms
              div(className="text-[11px] font-mono text-muted-foreground") EDGE
            div(className="bg-background p-3 text-center")
              div(className="text-[16px] font-medium text-accent-1") #{cacheHits}
              div(className="text-[11px] font-mono text-muted-foreground") HITS
            div(className="bg-background p-3 text-center")
              div(className="text-[16px] font-medium text-accent-2") #{hydrated}/#{results.length}
              div(className="text-[11px] font-mono text-muted-foreground") HYDRATED
          pre(className="bg-sidebar rounded-lg p-3 text-[11px] font-mono leading-relaxed overflow-x-auto mt-3 text-muted-foreground whitespace-pre-wrap break-words")
            code stream(async function*(){"{"}&#10;  yield &lt;skeleton&gt;&#10;  for(const i of hits) yield &lt;card&gt;&#10;{"}"}, {"{"}key:query, ssr:'streaming'{"}"})
          div(className="text-[11px] font-mono text-muted-foreground mt-2") Keyed cache at edge, HTTP streaming, incremental hydration.
        div(className="bg-sidebar rounded-xl p-4")
          div(className="text-[11px] font-mono tracking-wide text-foreground") TIP
          ul(className="list-disc list-inside text-[12px] font-mono text-muted-foreground mt-2 space-y-1")
            li Type worker → streams 1 chunk/280ms
            li Second search same query → cached 8ms
            li Skeleton shows instantly before DB
