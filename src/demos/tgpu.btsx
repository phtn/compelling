import Header from "@/components/ui/header.btsx"
import Frame from "@/components/ui/frame.btsx"
import { useEffect, useRef, useState } from "octane"

props {}:{}

setup
  const canvasRef = useRef<HTMLCanvasElement | null>(null)
  const containerRef = useRef<HTMLDivElement | null>(null)
  const [showInfo, setShowInfo] = useState(false)
  const toggleInfo = () => setShowInfo(!showInfo)
  const [supported, setSupported] = useState(true)
  const [fps, setFps] = useState(0)


  useEffect(() => {
    let cancelled = false
    let cleanup: (() => void) | null = null
    let raf = 0
    let frames = 0
    let last = performance.now()

    const tick = () => {
      frames++
      const now = performance.now()
      if (now - last > 500) {
        setFps(Math.round((frames * 1000) / (now - last)))
        frames = 0
        last = now
      }
      raf = requestAnimationFrame(tick)
    }

    // Feature detect WebGPU - your way preserved verbatim
    const initWebGPU = async () => {
      try {
        if (!navigator.gpu) {
          setSupported(false);
          return;
        }

        const adapter = await navigator.gpu.requestAdapter();
        const device = (await adapter?.requestDevice()) as GPUDevice;
        const canvas = canvasRef.current;

        if (!canvas) {
          setSupported(false);
          return;
        }

        const size = 2048;
        canvas.width = size;
        canvas.height = size;

        const context = canvas.getContext(
          "webgpu",
        ) as unknown as GPUCanvasContext;
        const format = navigator.gpu.getPreferredCanvasFormat();

        if (!context) {
          setSupported(false);
          return;
        };
      } catch (e) {
        setSupported(false);
        return;
      }
      setSupported(true);
      return true
    }

    void initWebGPU().then(async (ok) => {
      if (!ok || cancelled) return
      const canvas = canvasRef.current
      if (!canvas) return
      raf = requestAnimationFrame(tick)
    }).catch((e) => console.error(e))

    return () => {
      cancelled = true
      cancelAnimationFrame(raf)
      if (cleanup) cleanup()
    }
  }, [])

  const actions = [
    { id: "fps", label: supported ? `${fps} fps · 262k particles` : "WebGPU unavailable", className: "bg-card border-border text-muted-foreground" }
  ]

div.bg-background
  div(className="w-full px-6 py-6")
    // T
    Header(title="TypeGPU Attractors" subtitle="WEBGPU COMPUTE" icon='mechanics' description="262,144 particles with gravitational attractors — TypeGPU compute shaders via TSL. Drag attractors to orbit, scroll to zoom. Pure WebGPU, no CPU fallback." isVisible={showInfo} toggleFn={toggleInfo} actions={actions})
    if supported === false
      Frame(title="WebGPU TSL" subtitle={"0 fps · 0 particles · webgpu not enabled"})
        div(ref={containerRef} className="relative w-full h-[560px] bg-black overflow-hidden")
          div( className="p-4 block w-full h-full" width={1200} height={560} style="width:100%;height:100%;display:block")
            p(className="text-[12px] font-mono text-white mt-1") This demo requires a browser with WebGPU enabled (Chrome 113+, Edge, or Firefox Nightly with flag).
    else
      div(className="grid grid-cols-12 gap-4")
        div(className="col-span-12")
          // MAIN
          Frame(title="attractor — WebGPU TSL · compute + instanced" subtitle={fps + " fps · 262144 particles · drag to orbit"})
            div(ref={containerRef} className="relative w-full h-[560px] bg-black overflow-hidden")
              canvas(ref={canvasRef} className="block w-full h-full" width={1200} height={560} style="width:100%;height:100%;display:block")
          //
          div(className="mt-3 bg-card border border-border rounded-xs p-3 flex gap-3")
            div(className="text-accent-1 text-[12px]") ●
            div(className="text-[12px] leading-relaxed font-mono")
              div(className="font-medium text-foreground") Why TypeGPU
              div(className="text-muted-foreground mt-1") Three.js TSL shaders written in TypeScript with full type safety — attractor physics runs entirely on GPU via compute. No WGSL strings, no manual bind groups.
