import Header from "@/components/ui/header.btsx"
import Frame from "@/components/ui/frame.btsx"
import { useEffect, useRef, useState } from "octane"
import { mountAttractor } from "@/lib/tgpu/attractor-v2"

props {}:{}

setup
  const canvasRef = useRef<HTMLCanvasElement | null>(null)
  const containerRef = useRef<HTMLDivElement | null>(null)
  const [showInfo, setShowInfo] = useState(false)
  const toggleInfo = () => setShowInfo(!showInfo)
  const [supported, setSupported] = useState(true)
  const [fps, setFps] = useState(0)
  const [particles, setParticles] = useState(0)

  useEffect(() => {
    let cancelled = false
    let cleanup: (() => void) | null = null
    let raf = 0
    let frames = 0
    let last = performance.now()

    const tick = () => {
      frames++
      const now = performance.now()
      if (now - last > 500) {
        setFps(Math.round((frames * 1000) / (now - last)))
        frames = 0
        last = now
      }
      raf = requestAnimationFrame(tick)
    }

    // Feature detect WebGPU — let WebGPURenderer own device/context
    const initWebGPU = async () => {
      if (!navigator.gpu) {
        console.log('navigator.gpu not available')
        setSupported(false)
        return false
      }
      const adapter = await navigator.gpu.requestAdapter()
      if (!adapter) {
        console.log('adapter not available')
        setSupported(false)
        return false
      }
      console.log('adapter available')
      setSupported(true)
      return true
    }

    initWebGPU().then(async (ok) => {
      if (!ok || cancelled) {
        if (!cancelled) setSupported(false)
        return
      }
      const canvas = canvasRef.current
      if (!canvas) {
        setSupported(false)
        console.log('canvas not available')
        return
      }
      if (cancelled) {
        console.log('cancelled')
        return
      }
      raf = requestAnimationFrame(tick)
      try {
        const fn = await mountAttractor(canvas)
        if (cancelled) {
          fn()
          console.log('cancelled')
          return
        }
        cleanup = fn
        setParticles(262144)
        setSupported(true)
      } catch (e) {
        console.error(e)
        if (!cancelled) setSupported(false)
      }
      setSupported(true)
    })

    return () => {
      cancelled = true
      cancelAnimationFrame(raf)
      if (cleanup) cleanup()
    }
  }, [])

  const actions = [
    { id: "fps", label: supported ? `${fps} fps · ${particles} particles` : "WebGPU unavailable", className: "bg-card border-border text-muted-foreground" }
  ]

div.bg-background
  div(className="w-full px-2 sm:px-3 md:px-4 lg:px-5 xl:px-6 py-6")
    // T
    Header(title="TypeGPU" subtitle="WEBGPU COMPUTE" icon='mechanics' description="262,144 particles with gravitational attractors — TypeGPU compute shaders via TSL. Drag attractors to orbit, scroll to zoom. Pure WebGPU, no CPU fallback." isVisible={showInfo} toggleFn={toggleInfo} actions={actions})
    if supported === false
      Frame(title="Attractor" subtitle={"0 fps · 0 particles · webgpu not enabled"})
        div(ref={containerRef} className="relative w-full h-[560px] bg-black overflow-hidden")
          div( className="p-4 block w-full h-full" width={1200} height={560} style="width:100%;height:100%;display:block")
            p(className="text-[12px] font-mono text-white mt-1") This demo requires a browser with WebGPU enabled (Chrome 113+, Edge, or Firefox Nightly with flag).
    else
      div(className="grid grid-cols-12 gap-4")
        div(className="col-span-12")
          // MAIN
          Frame(title="Attractor" subtitle={`${fps} fps · ${particles} particles · drag to orbit`})
            div(ref={containerRef} className="relative w-full h-[560px] bg-black overflow-hidden")
              canvas(ref={canvasRef} className="block w-full h-full" width={1200} height={560} style="width:100%;height:100%;")
          //
          div(className="mt-3 bg-border/15 rounded-xl p-3 flex gap-3")
            div(className="text-orange-300 text-[12px]") ●
            div(className="text-[12px] leading-relaxed font-mono")
              div(className="font-medium text-foreground") Why TypeGPU
              div(className="text-muted-foreground mt-1") Three.js TSL shaders written in TypeScript with full type safety — attractor physics runs entirely on GPU via compute. No WGSL strings, no manual bind groups.
