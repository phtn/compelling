import Button from "@/components/ui/button.btsx"
import Icon from "@/lib/icons/index.btsx"
import { navGroups } from "@/components/ui/sidebar/navs"

props {}: {}

setup
  const navs = navGroups[0].items.slice(1, navGroups[0].items.length)
  const highlights = [{label: 'substantial Demos', value: 9}, {label: 'target interaction', value:'60fps' }, {label: 'routing', value: 'vite'}, {label: 'subscriptions', value: '0'}]

div
  section(className="w-full px-2 sm:px-3 md:px-4 lg:px-5 xl:px-6 py-6")
    div(className="inline-flex items-center gap-2 px-2.5 py-1 rounded-lg bg-card border border-input text-muted-foreground text-[11px] font-mono tracking-wide")
      span(className="size-2 rounded-xs bg-orange-300 animate-pulse")
      span  BEAST &rarr; OCTANE &rarr; VITE
    h1(className="text-[40px] sm:text-[56px] font-semibold tracking-[-0.04em] leading-[0.95] mt-6 text-foreground max-w-[720px]")
      span Compelling
      span(className="block text-muted-foreground") beast examples.
    p(className="text-[15px] text-muted-foreground leading-relaxed max-w-[580px] mt-4") Powered by OctaneJS and Vite.

    // HIGHLIGHTS
    div(className="grid grid-cols-2 sm:grid-cols-4 gap-px bg-background border border-border rounded-xl overflow-hidden mt-8 invert")
      each highlight in highlights
        div(className="border-r py-2 px-5 border-border/50 last:border-r-0")
          div(className="text-base font-semibold tracking-[-0.02em] text-foreground") #{highlight.value}
          div(className="text-xs tracking-[-0.02em] font-mono text-muted-foreground capitalize") #{highlight.label}


  // GRID
  section(className="w-full px-3 md:px-4 lg:px-5 xl:px-6 pb-12")
    div(className="grid lg:grid-cols-2 gap-px bg-border/50 border border-border/50 rounded-xl overflow-hidden")
      each nav in navs key nav.href
        a(className="group bg-background p-6 hover:bg-card transition flex flex-col gap-4" href={nav.href})
          // TITLE
          div
            div.flex.items-start.justify-between
              h3(className="font-sans font-semibold text-foreground group-hover:text-foreground text-base tracking-tighter transition") #{nav.title}
              span(className="px-2 py-1 rounded-full bg-border/5 text-[10px] font-mono text-blue-500") #{nav.href}
            p(className="text-sm text-muted-foreground mt-4 leading-relaxed min-h-14") #{nav.description}

          // TAGS
          div.flex.items-center.justify-between
            div.flex.flex-wrap.mt-1.border.border-border.rounded-lg.w-fit.divide-x.overflow-hidden(className="divide-border/50")
              each tag in nav.tags key tag
                span(className="px-2 py-1 rounded-xs bg-card text-[11px] font-mono text-muted-foreground") #{tag}
            Icon(name="arrow-right")

  section(className="w-full px-6 pb-12")
    div(className="bg-card border border-border rounded-xl p-6 sm:p-8")
      h2(className="text-[14px] font-medium tracking-[-0.01em] text-foreground flex items-center gap-2")
        span(className="w-1 h-4 bg-primary rounded-xs inline-block")
        span How routing works
      p(className="text-muted-foreground text-[13px] mt-2 max-w-2xl leading-relaxed font-mono") Vite SPA routing with history API. App state tracks window.location.pathname, pushState on navigation, popstate for back/forward. No external router, no page reloads. Direct hits fallback to index.html via Vite appType spa.
      div(className="grid sm:grid-cols-3 gap-px bg-border border border-border rounded-xs overflow-hidden mt-6")
        div(className="bg-background p-4")
          div(className="font-medium text-[13px] text-foreground") / → Home
          div(className="text-muted-foreground text-[12px] mt-1 font-mono") Landing + overview
        div(className="bg-background p-4")
          div(className="font-medium text-[13px] text-foreground") /canvas · /form · /grid · /shell
          div(className="text-muted-foreground text-[12px] mt-1 font-mono") Each demo isolated, own route, deep-linkable
        div(className="bg-background p-4")
          div(className="font-medium text-[13px] text-foreground") Vite appType: spa
          div(className="text-muted-foreground text-[12px] mt-1 font-mono") History fallback in dev + preview
      div.flex.flex-wrap.gap-2.mt-6
        a(className="px-4 py-2 rounded-xs bg-accent-1 text-foreground font-medium text-[13px] hover:bg-primary" href="/canvas") Start with Canvas →
        a(className="px-4 py-2 rounded-xs bg-background border border-input text-foreground font-medium text-[13px] hover:bg-muted transition" href="https://github.com/octanejs/octane" target="_blank" rel="noreferrer") Octane docs →
