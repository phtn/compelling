  section(className="w-full px-6 pb-12")
    div(className="grid lg:grid-cols-2 gap-px bg-border border border-border rounded-xl overflow-hidden")
      a(className="group bg-background p-6 hover:bg-card transition flex flex-col gap-4" href="/canvas")
        div.flex.items-start.justify-between.gap-4
