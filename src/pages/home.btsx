  section(className="w-full px-6 py-8")
    div(className="bg-[#0a0a0a] border border-[#1a1a1a] rounded-xs overflow-hidden")
      div(className="p-4 border-b border-[#1a1a1a] flex flex-wrap items-center justify-between gap-4")
        h2(className="text-[13px] font-medium tracking-[-0.01em] text-white") Summary map
        p(className="text-[12px] font-mono text-[#666]") Each demo targets a typical pain point in React/Vue/Svelte and shows Octane's answer.
      div.overflow-x-auto
        table(className="w-full text-[13px]")
          thead
            tr(className="border-b border-[#1a1a1a] text-left text-[11px] tracking-wide font-mono text-[#666]")
              th.px-4.py-3.font-medium DEMO
              th.px-4.py-3.font-medium OCTANE ADVANTAGE
              th.px-4.py-3.font-medium TYPICAL PAIN IN OTHERS
              th.px-4.py-3.font-medium ROUTE
          tbody(className="font-mono text-[12px]")
            tr(className="border-b border-[#1a1a1a] hover:bg-[#111] transition")
              td.px-4.py-3.font-medium.text-white.font-sans Collaborative Canvas
              td(className="px-4 py-3 text-[#888]") Granular reactive updates, delta sync
              td(className="px-4 py-3 text-[#666]") Virtual DOM reconciliation cost
