            tr(className="border-b border-[#1a1a1a] hover:bg-[#111] transition")
              td.px-4.py-3.font-medium.text-white.font-sans Adaptive Form
              td(className="px-4 py-3 text-[#888]") Automatic cancellation, debounce
              td(className="px-4 py-3 text-[#666]") Manual subscription cleanup (RxJS)
              td.px-4.py-3
                a(className="inline-flex px-2 py-1 rounded-xs bg-accent-2 text-white text-[11px] font-medium border border-accent-2" href="/form") /form
            tr(className="border-b border-[#1a1a1a] hover:bg-[#111] transition")
              td.px-4.py-3.font-medium.text-white.font-sans Masonry Grid
              td(className="px-4 py-3 text-[#888]") Dynamic measurement, virtualize
              td(className="px-4 py-3 text-[#666]") Fixed-size assumptions (react-window)
              td.px-4.py-3
                a(className="inline-flex px-2 py-1 rounded-xs bg-accent-1 text-white text-[11px] font-medium border border-accent-1" href="/grid") /grid
            tr(className="hover:bg-[#111] transition")
              td.px-4.py-3.font-medium.text-white.font-sans Isomorphic Shell
              td(className="px-4 py-3 text-[#888]") Universal suspend/resume, partial hydration
              td(className="px-4 py-3 text-[#666]") Framework-specific boundaries (Next.js)
              td.px-4.py-3
